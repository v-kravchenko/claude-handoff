const TOKEN = "__TOKEN__";

function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}

// Text with `inline code` spans; never parsed as HTML.
function rich(tag, cls, text) {
  const e = el(tag, cls);
  String(text).split(/`([^`]+)`/).forEach((part, i) => {
    if (part) e.appendChild(i % 2 ? el("code", "", part) : document.createTextNode(part));
  });
  return e;
}

function age(iso) {
  const t = Date.parse(iso);
  if (isNaN(t)) return "";
  const s = Math.max(0, (Date.now() - t) / 1000);
  if (s < 60) return "just now";
  if (s < 3600) return Math.floor(s / 60) + "m ago";
  if (s < 86400) return Math.floor(s / 3600) + "h ago";
  if (s < 86400 * 14) return Math.floor(s / 86400) + "d ago";
  if (s < 86400 * 60) return Math.floor(s / 86400 / 7) + "w ago";
  return new Date(t).toLocaleDateString();
}

const sq = (s) => "'" + s.replace(/'/g, "'\\''") + "'";
function underHome(p) {
  const h = data && data.home;
  if (!h || h === "/") return null;
  if (p === h) return "";
  return p.startsWith(h + "/") ? p.slice(h.length + 1) : null;
}
function tilde(p) {
  const r = underHome(p);
  return r === null ? p : r ? "~/" + r : "~";
}
function command(t) {
  const run = 'claude "/pickup @' + t.task + '"';
  if (!t.project_exists) return run;
  const r = underHome(t.project);
  const dir = r === null ? sq(t.project) : r ? "~/" + sq(r) : "~";
  return "cd " + dir + " && " + run;
}

async function copy(text, btn, codeEl, label) {
  const lbl = btn.querySelector(".lbl") || btn;
  const done = (msg) => { lbl.textContent = msg; setTimeout(() => { lbl.textContent = label; }, 1500); };
  try {
    await navigator.clipboard.writeText(text);
    return done("Copied");
  } catch (e) { /* fall through */ }
  try {
    const a = document.createElement("textarea");
    a.value = text; a.setAttribute("readonly", ""); a.style.position = "fixed"; a.style.opacity = "0";
    document.body.appendChild(a); a.select();
    const ok = document.execCommand("copy");
    a.remove();
    if (ok) return done("Copied");
  } catch (e) { /* fall through */ }
  codeEl.hidden = false;
  const r = document.createRange(); r.selectNodeContents(codeEl);
  const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
  done("Selected");
}

// --- markdown (DOM-built, never innerHTML) ---
function link(href, text) {
  const a = el("a", "", text);
  a.href = href; a.target = "_blank"; a.rel = "noopener noreferrer";
  return a;
}

function inline(parent, text) {
  const re = /(`[^`]+`)|\*\*([^*]+)\*\*|\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|(https?:\/\/[^\s<>()]*[^\s<>().,;:!?'"])/g;
  let last = 0, m;
  while ((m = re.exec(text))) {
    if (m.index > last) parent.appendChild(document.createTextNode(text.slice(last, m.index)));
    if (m[1]) parent.appendChild(el("code", "", m[1].slice(1, -1)));
    else if (m[2]) { const b = el("strong"); inline(b, m[2]); parent.appendChild(b); }
    else if (m[3]) parent.appendChild(link(m[4], m[3]));
    else parent.appendChild(link(m[5], m[5]));
    last = re.lastIndex;
  }
  if (last < text.length) parent.appendChild(document.createTextNode(text.slice(last)));
  return parent;
}

const ITEM = /^\s*([-*+]|\d+[.)])\s+(.*)$/;
const BLOCK = /^(#{1,6}\s|```|~~~|\|)/;
const indentOf = (l) => l.match(/^\s*/)[0].replace(/\t/g, "    ").length;

function mdList(lines, i, parent) {
  const base = indentOf(lines[i]);
  const list = el(/^\s*\d/.test(lines[i]) ? "ol" : "ul");
  let li = null;
  while (i < lines.length) {
    const l = lines[i];
    if (!l.trim()) {
      const n = lines[i + 1];
      if (n !== undefined && n.trim() && indentOf(n) >= base && (ITEM.test(n) || indentOf(n) > base)) { i++; continue; }
      break;
    }
    const ind = indentOf(l), m = l.match(ITEM);
    if (m && ind <= base + 1 && ind >= base) { li = inline(el("li"), m[2]); list.appendChild(li); i++; }
    else if (m && ind > base && li) i = mdList(lines, i, li);
    else if (!m && ind > base && li) { li.appendChild(document.createTextNode(" ")); inline(li, l.trim()); i++; }
    else break;
  }
  parent.appendChild(list);
  return i;
}

function cells(l) {
  return l.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((c) => c.trim());
}

function markdown(src, title) {
  const root = el("div", "md");
  const lines = src.replace(/\r/g, "").split("\n");
  let i = 0, m;
  while (i < lines.length) {
    const line = lines[i];
    if (!line.trim()) { i++; continue; }
    if ((m = line.match(/^(```|~~~)/))) {
      const buf = [];
      for (i++; i < lines.length && !lines[i].startsWith(m[1]); i++) buf.push(lines[i]);
      i++;
      const pre = el("pre"); pre.appendChild(el("code", "", buf.join("\n"))); root.appendChild(pre);
    } else if ((m = line.match(/^(#{1,6})\s+(.*)$/))) {
      i++;
      if (m[1].length === 1 && m[2].trim() === title) continue;  // the card already shows the title
      root.appendChild(inline(el("h" + Math.min(6, m[1].length + 2)), m[2]));
    } else if (ITEM.test(line)) {
      i = mdList(lines, i, root);
    } else if (line.trim().startsWith("|")) {
      const table = el("table");
      let head = true;
      for (; i < lines.length && lines[i].trim().startsWith("|"); i++) {
        if (/^\s*\|?[\s:|-]+\|?\s*$/.test(lines[i]) && lines[i].includes("-")) { head = false; continue; }
        const tr = el("tr");
        cells(lines[i]).forEach((c) => tr.appendChild(inline(el(head ? "th" : "td"), c)));
        table.appendChild(tr);
      }
      root.appendChild(table);
    } else {
      const buf = [];
      while (i < lines.length && lines[i].trim() && !BLOCK.test(lines[i]) && !ITEM.test(lines[i])) buf.push(lines[i++].trim());
      root.appendChild(inline(el("p"), buf.join(" ")));
    }
  }
  return root;
}

const ICONS = {
  copy: ["M9 9h11v11H9z", "M5 15V5a2 2 0 0 1 2-2h10"],
  check: ["M5 12l5 5L20 7"],
  undo: ["M9 14L4 9l5-5", "M4 9h10a6 6 0 0 1 0 12h-3"],
  down: ["M6 9l6 6 6-6"],
  up: ["M6 15l6-6 6 6"],
  reload: ["M20 11a8 8 0 1 0-2.3 5.7", "M20 4v7h-7"],
  folder: ["M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"],
  branch: ["M6 3v12", "M18 6a3 3 0 1 0 0 .01", "M6 18a3 3 0 1 0 0 .01", "M18 9c0 6-12 3-12 9"],
  commit: ["M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6", "M3 12h6", "M15 12h6"],
  edit: ["M4 20h4L19 9l-4-4L4 16z", "M13 7l4 4"],
  x: ["M6 6l12 12", "M18 6L6 18"],
  trash: ["M4 7h16", "M9 7V4h6v3", "M6 7l1 13h10l1-13"],
};
function icon(name) {
  const NS = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(NS, "svg");
  svg.setAttribute("viewBox", "0 0 24 24"); svg.setAttribute("aria-hidden", "true");
  ICONS[name].forEach((d) => { const p = document.createElementNS(NS, "path"); p.setAttribute("d", d); svg.appendChild(p); });
  return svg;
}
// A button with an icon and an optional short label (label text lives in .lbl).
function ibtn(name, label, cls) {
  const b = el("button", "ib" + (cls ? " " + cls : ""));
  b.appendChild(icon(name));
  if (label) b.appendChild(el("span", "lbl", label));
  return b;
}

function chip(text, cls, title) {
  const c = el("span", "chip" + (cls ? " " + cls : ""), text);
  if (title) c.title = title;
  return c;
}

const base = (p) => p.replace(/\/+$/, "").split("/").pop();
const DAY = 86400000;

async function api(path, params) {
  const r = await fetch("api/" + path + (params ? "?" + new URLSearchParams(params) : ""), { cache: "no-store" });
  if (!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}

async function post(path, body) {
  const r = await fetch("api/" + path, {
    method: "POST", cache: "no-store",
    headers: { "Content-Type": "application/json", "X-Handoffs-Token": TOKEN },
    body: JSON.stringify(body),
  });
  const res = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(res.error || "HTTP " + r.status);
  return res;
}

const keyOf = (t) => t.slug + "|" + t.status + "|" + t.task;
const ref = (t) => ({ slug: t.slug, status: t.status, task: t.task });

function copyButton(label, text) {
  const btn = ibtn("copy", label, "primary");
  btn.title = text;
  const code = el("code", "", text);
  code.hidden = true;  // shown only when the command has to be copied by hand
  btn.addEventListener("click", () => copy(text, btn, code, label));
  return [btn, code];
}

function diffView(text) {
  const pre = el("pre", "diff");
  if (!text) { pre.textContent = "No differences."; return pre; }
  text.split("\n").forEach((l) => {
    const cls = l.startsWith("@@") ? "hunk" : l.startsWith("+") && !l.startsWith("+++") ? "add"
      : l.startsWith("-") && !l.startsWith("---") ? "del" : "";
    pre.appendChild(el("span", cls, l + "\n"));
  });
  return pre;
}

// Details: git context, then tabs Latest / History and Rename, Done/Restore.
function details(t, box, actions) {
  const crumbs = gitCrumbs(t);
  const tabs = el("div", "seg tabs");
  const view = el("div");
  const latest = el("button", "", "Latest");
  const hist = el("button", "", t.versions > 1 ? "History (" + t.versions + ")" : "History");
  tabs.appendChild(latest); tabs.appendChild(hist);
  const bar = el("div", "dbar");
  bar.appendChild(tabs);
  actions.forEach((a) => bar.appendChild(a));
  if (crumbs) box.appendChild(crumbs);
  box.appendChild(bar); box.appendChild(view);
  const fail = (e) => { view.textContent = "Cannot load (" + e.message + ")."; };
  const select = (b) => [latest, hist].forEach((x) => x.setAttribute("aria-pressed", String(x === b)));

  async function showFile(file) {
    const h = await api("handoff", Object.assign(ref(t), file ? { file } : {}));
    view.textContent = "";
    view.appendChild(markdown(h.body, t.title));
    view.appendChild(el("div", "file", h.file));
  }
  async function showHistory() {
    const rows = await api("history", ref(t));
    view.textContent = "";
    const list = el("div", "history");
    let current = null;  // the button whose result is open
    rows.forEach((v, i) => {
      const row = el("div", "hrow");
      const when = el("span", "age", age(v.created));
      when.title = v.created;
      row.appendChild(when);
      row.appendChild(rich("span", "htitle", v.title));
      const btns = el("span", "hbtns");
      const panel = el("div", "hpanel");
      panel.hidden = true;
      // toggle(btn, loader): shows the loader's result right under this row.
      const toggle = (btn, loader) => {
        if (current) current.setAttribute("aria-pressed", "false");
        if (current === btn) { current = null; panel.hidden = true; return; }
        list.querySelectorAll(".hpanel").forEach((p) => { p.hidden = true; });
        current = btn;
        btn.setAttribute("aria-pressed", "true");
        panel.hidden = false;
        panel.textContent = "Loading…";
        loader().then((node) => {
          panel.textContent = "";
          panel.appendChild(node);
          panel.scrollIntoView({ block: "nearest" });
        }).catch((e) => { panel.textContent = "Cannot load (" + e.message + ")."; });
      };
      const open = el("button", "", "View");
      open.addEventListener("click", () => toggle(open, async () => {
        const h = await api("handoff", Object.assign(ref(t), { file: v.file }));
        const box = el("div");
        box.appendChild(el("div", "file", h.file));
        box.appendChild(markdown(h.body, null));
        return box;
      }));
      btns.appendChild(open);
      if (i + 1 < rows.length) {
        const d = el("button", "", "Diff");
        d.title = "changes since the previous version";
        d.addEventListener("click", () => toggle(d, async () => {
          const r = await api("diff", Object.assign(ref(t), { old: rows[i + 1].file, new: v.file }));
          const box = el("div");
          box.appendChild(el("div", "file", r.old + " → " + r.new));
          box.appendChild(diffView(r.diff));
          return box;
        }));
        btns.appendChild(d);
      }
      row.appendChild(btns);
      list.appendChild(row);
      list.appendChild(panel);
    });
    view.appendChild(list);
  }

  latest.addEventListener("click", () => { select(latest); showFile("").catch(fail); });
  hist.addEventListener("click", () => { select(hist); view.textContent = "Loading…"; showHistory().catch(fail); });
  select(latest);
  view.textContent = "Loading…";
  return showFile("");
}

function chips(t) {
  const box = el("div", "chips");
  if (t.status === "archived") box.appendChild(chip("archived", "archived"));
  if (!t.project_exists) box.appendChild(chip("path missing", "missing", t.project));
  const idle = Math.floor((Date.now() - Date.parse(t.created)) / DAY);
  if (t.status === "active" && idle >= IDLE_DAYS) box.appendChild(chip("idle " + idle + "d", "warn", "not updated for " + idle + " days"));
  return box;
}

// Git context as breadcrumb segments: branch > commit (null without git info).
function gitCrumbs(t) {
  const crumbs = el("span", "crumbs mono");
  const seg = (cls, name, text, title) => {
    const c = el("span", "crumb " + cls);
    c.appendChild(icon(name));
    c.appendChild(el("span", "", text));
    c.title = title;
    crumbs.appendChild(c);
  };
  // Git info only when the project directory itself is the repository.
  const git = t.git;
  if (git && t.branch) seg("branch", "branch", t.branch, "branch");
  if (git && t.commit) seg("commit", "commit", t.commit, "commit at handoff time");
  return crumbs.childNodes.length ? crumbs : null;
}

function card(t) {
  const c = el("div", "card");
  const head = el("div", "head");
  const top = el("div", "top");
  top.appendChild(el("span", "task", "@" + t.task));
  const a = el("span", "age", age(t.created));
  a.title = t.created;
  top.appendChild(a);
  head.appendChild(top);
  if (t.title !== t.task) head.appendChild(rich("div", "title", t.title));
  const snippet = hits.get(keyOf(t));
  if (snippet) head.appendChild(el("div", "snippet", snippet));
  head.appendChild(chips(t));
  c.appendChild(head);
  const box = el("div", "details");
  box.hidden = true;

  const row = el("div", "actions");
  const [copyBtn, code] = copyButton(LABEL, command(t));
  copyBtn.title = "Copy: " + command(t);
  row.appendChild(copyBtn);

  // Rename and Done/Restore live in Details, away from the main button.
  const acts = [];
  if (data.writable) {
    const ren = ibtn("edit", "Rename", "ren");
    ren.title = "rename @" + t.task;
    ren.addEventListener("click", async () => {
      const name = prompt("New name for @" + t.task + " (lowercase a-z0-9._-):", t.task);
      const next = name && name.trim().replace(/^@/, "");
      if (!next || next === t.task) return;
      if (!/^[a-z0-9][a-z0-9._-]*$/.test(next) || next === "_archive") { alert("Invalid name: use lowercase a-z0-9._-"); return; }
      ren.disabled = true;
      try { await post("rename", { slug: t.slug, status: t.status, task: t.task, new: next }); await load(); }
      catch (e) { ren.disabled = false; alert("Failed: " + e.message); }
    });
    acts.push(ren);
    const done = t.status === "active";
    const act = ibtn(done ? "check" : "undo", done ? "Done" : "Restore", "act");
    act.title = done ? "archive the task (like /handoff @" + t.task + " done)" : "move the task back to active";
    act.addEventListener("click", async () => {
      if (!confirm((done ? "Archive" : "Restore") + " @" + t.task + "?")) return;
      act.disabled = true;
      try { await post(done ? "done" : "restore", { slug: t.slug, task: t.task }); await load(); }
      catch (e) { act.disabled = false; alert("Failed: " + e.message); }
    });
    acts.push(act);
  }

  const more = ibtn("down", "Details", "toggle");
  more.title = "Details";
  more.setAttribute("aria-label", "Details");
  more.setAttribute("aria-expanded", "false");
  let loaded = false;
  const toggle = () => {
    const open = box.hidden;
    if (open) { if (closeOpen && closeOpen !== close) closeOpen(); closeOpen = close; }
    else if (closeOpen === close) closeOpen = null;
    if (open && !loaded) { loaded = true; details(t, box, acts).catch((e) => { box.textContent = "Cannot load (" + e.message + ")."; }); }
    box.hidden = !open;
    c.classList.toggle("open", open);
    more.classList.toggle("flip", open);
    more.setAttribute("aria-expanded", String(open));
  };
  const close = () => { if (!box.hidden) toggle(); };
  more.addEventListener("click", toggle);
  head.addEventListener("click", (e) => { if (!getSelection().toString()) toggle(); });
  row.appendChild(more);
  row.appendChild(code);
  c.appendChild(row);  // buttons stay above the (long) details
  c.appendChild(box);
  return c;
}

// Tips saved by /handoff (skills/handoff/tips.sh): read, verify, refute, delete.
function tipCard(tip) {
  const c = el("div", "card" + (tip.status === "active" ? "" : " dim"));
  const head = el("div", "head");
  const top = el("div", "top");
  top.appendChild(el("span", "task", tip.id));
  const a = el("span", "age", age(tip.modified));
  a.title = "modified " + tip.modified;
  top.appendChild(a);
  head.appendChild(top);
  head.appendChild(rich("div", "title", tip.title));
  const cs = el("div", "chips");
  if (tip.status !== "active") cs.appendChild(chip(tip.status, "warn", tip.refuted || tip.superseded_by));
  if (tip.env) cs.appendChild(chip("env: " + tip.env));
  if (tip.origin === "web") cs.appendChild(chip("from web", "", "learned from web pages, issues or foreign code"));
  if (tip.last_verified) cs.appendChild(chip("verified " + tip.last_verified));
  head.appendChild(cs);
  c.appendChild(head);

  const box = el("div", "details");
  box.hidden = true;
  const meta = (label, v) => { if (v) box.appendChild(rich("div", "tipmeta", label + ": " + v)); };
  meta("When", tip.when);
  meta("Keywords", tip.keywords);
  meta("Refuted", tip.refuted);
  meta("Superseded by", tip.superseded_by);
  // "Tip: / Why: / Verify:" lines are separate paragraphs, not one.
  box.appendChild(markdown(tip.body.replace(/\n(?=[A-Z][a-z]+: )/g, "\n\n"), tip.title));
  box.appendChild(el("div", "file", tilde(tip.file)));
  if (data.writable) {
    const row = el("div", "actions");
    const act = (name, label, title, run) => {
      const b = ibtn(name, label);
      b.title = title;
      b.addEventListener("click", async () => {
        const body = run();
        if (!body) return;
        b.disabled = true;
        try { await post("tip", Object.assign({ slug: tip.slug, id: tip.id }, body)); await load(); }
        catch (e) { b.disabled = false; alert("Failed: " + e.message); }
      });
      row.appendChild(b);
    };
    act("check", "Verified", "the tip still holds (sets last_verified)", () => ({ action: "verified" }));
    if (tip.status !== "refuted") act("x", "Refute", "the tip is wrong; search stops returning it", () => {
      const why = prompt("Why is " + tip.id + " wrong?");
      return why === null ? null : { action: "refuted", reason: why };
    });
    act("trash", "Delete", "delete the tip file", () => confirm("Delete tip " + tip.id + "?") ? { action: "delete" } : null);
    box.appendChild(row);
  }
  head.addEventListener("click", () => {
    if (getSelection().toString()) return;
    box.hidden = !box.hidden;
    c.classList.toggle("open", !box.hidden);
  });
  c.appendChild(box);
  return c;
}

// A collapsed "Tips (N)" toggle and its cards; active tips first, newest first.
function tipsBlock(sec, key, label, tips) {
  if (!tips.length) return;
  tips.sort((a, b) => (a.status !== "active") - (b.status !== "active") || b.modified.localeCompare(a.modified));
  const open = !!state.q.trim() || state.tipsOpen.includes(key);
  const tog = ibtn("down", label + " (" + tips.length + ")", "archtoggle" + (open ? "" : " shut"));
  tog.title = "unverified hints saved by /handoff; search them with /tips";
  tog.addEventListener("click", () => {
    const i = state.tipsOpen.indexOf(key);
    if (i >= 0) state.tipsOpen.splice(i, 1); else state.tipsOpen.push(key);
    render();
  });
  sec.appendChild(tog);
  if (open) tips.forEach((t) => sec.appendChild(tipCard(t)));
}

function projectName(p) {
  const t = tilde(p);
  return t === "~" ? "~" : base(t) || t;
}

function render() {
  if (!data) return;
  closeOpen = null;
  const all = data.tasks;
  // Tips are grouped by slug; a project is found through its tasks' slug.
  const slugOf = {};
  all.forEach((t) => { if (!(t.project in slugOf)) slugOf[t.project] = t.slug; });
  const known = new Set(Object.values(slugOf));
  const tips = data.tips || [];
  const tipOnly = [...new Set(tips.map((t) => t.slug))].filter((s) => s !== "_global" && !known.has(s));
  tipOnly.forEach((s) => { slugOf[s] = s; });
  const projects = [...new Set(all.map((t) => t.project))].concat(tipOnly);  // tasks are newest first

  const q = state.q.trim().toLowerCase();
  const matches = (t) => !q || hits.has(keyOf(t)) ||
    [t.task, t.title, t.goal, t.project].some((f) => f && f.toLowerCase().includes(q));
  const tipMatches = (t) => !q ||
    [t.id, t.title, t.when, t.keywords, t.body].some((f) => f && f.toLowerCase().includes(q));
  const tipsOf = (slug) => tips.filter((t) => t.slug === slug && tipMatches(t));
  $("#root").textContent = "Root: " + tilde(data.root) + " · handoffs " + data.version;

  const list = $("#list");
  list.textContent = "";
  let shownAny = false;
  projects.forEach((project) => {
    const tasks = all.filter((t) => t.project === project && matches(t));
    const ptips = tipsOf(slugOf[project]);
    if (!tasks.length && !ptips.length) return;
    shownAny = true;
    const act = tasks.filter((t) => t.status === "active");
    const arch = tasks.filter((t) => t.status === "archived");
    const collapsed = !q && state.collapsed.includes(project);

    const sec = el("section", "project");
    const h = el("h2");
    h.title = project;
    const chev = el("span", "chev" + (collapsed ? " shut" : ""));
    chev.appendChild(icon("down"));
    h.appendChild(chev);
    // One path, parent dimmed: "~/" + bold "claude-handoff".
    const full = tilde(project), name = projectName(project);
    const ptitle = el("span", "ptitle");
    if (full.length > name.length) ptitle.appendChild(el("span", "ppath", full.slice(0, full.length - name.length)));
    ptitle.appendChild(el("span", "pname", name));
    if (full === "~") ptitle.appendChild(el("span", "phint", " (home)"));
    h.appendChild(ptitle);
    if (tasks.length && !tasks[0].project_exists) h.appendChild(chip("path missing", "missing"));
    h.appendChild(el("span", "count", act.length + " active"));
    h.addEventListener("click", () => {
      const i = state.collapsed.indexOf(project);
      if (i >= 0) state.collapsed.splice(i, 1); else state.collapsed.push(project);
      store.set("handoffs.collapsed", JSON.stringify(state.collapsed));
      render();
    });
    sec.appendChild(h);
    if (!collapsed) {
      act.forEach((t) => sec.appendChild(card(t)));
      if (!act.length && all.some((t) => t.project === project)) sec.appendChild(el("div", "none", "No active tasks."));
      if (arch.length) {
        const open = !!q || state.archOpen.includes(project);
        const tog = ibtn("down", "Archived (" + arch.length + ")", "archtoggle" + (open ? "" : " shut"));
        tog.title = "tasks finished with Done or /handoff @task done";
        tog.addEventListener("click", () => {
          const i = state.archOpen.indexOf(project);
          if (i >= 0) state.archOpen.splice(i, 1); else state.archOpen.push(project);
          render();
        });
        sec.appendChild(tog);
        if (open) arch.forEach((t) => sec.appendChild(card(t)));
      }
      tipsBlock(sec, slugOf[project], "Tips", ptips);
    }
    list.appendChild(sec);
  });
  const gtips = tipsOf("_global");
  if (gtips.length) {
    shownAny = true;
    const sec = el("section", "project");
    tipsBlock(sec, "_global", "Global tips", gtips);
    list.appendChild(sec);
  }
  if (!shownAny) {
    list.appendChild(el("div", "empty", all.length || tips.length ? "Nothing matches the search." : "No handoffs yet. Save one with /handoff."));
  }
}

async function load() {
  try {
    const r = await fetch("api/tasks", { cache: "no-store" });
    if (!r.ok) throw new Error("HTTP " + r.status);
    const next = await r.json();
    $("#error").hidden = true;
    const same = data && JSON.stringify(next) === JSON.stringify(data);
    data = next;
    if (!same) render();
  } catch (e) {
    $("#error").textContent = "Cannot reach the handoffs server (" + e.message + "). Is it still running?";
    $("#error").hidden = false;
  }
}

$("#reload").appendChild(icon("reload"));
$("#reload").addEventListener("click", load);
let searchTimer = 0;
$("#q").addEventListener("input", (e) => {
  state.q = e.target.value;
  clearTimeout(searchTimer);
  if (state.q.trim().length < 2) { hits = new Map(); render(); return; }
  render();
  searchTimer = setTimeout(async () => {
    const q = state.q;
    try {
      const res = await api("search", { q });
      if (q !== state.q) return;
      hits = new Map(res.map((h) => [keyOf(h), h.snippet]));
      render();
    } catch (err) { /* keep the local filter */ }
  }, 300);
});
document.addEventListener("visibilitychange", () => { if (!document.hidden) load(); });
setInterval(() => { if (!document.hidden) load(); }, 30000);
load();
</script>
</body>
</html>
"""

if __name__ == "__main__":
    sys.exit(main())
