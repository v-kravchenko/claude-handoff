#!/usr/bin/env python3
"""Local web dashboard for claude-handoff tasks (part of claude-handoff).

Usage: handoffs [--port N] [--host ADDR] [--no-open] [--read-only] [--background | --stop]
                [--json] [--version]
       handoffs service install|uninstall|restart|status [--port N] [--dry-run]

Serves a page with every task of every project under the handoff
root ($HANDOFF_ROOT, else $CLAUDE_CONFIG_DIR/handoffs, else ~/.claude/handoffs).
Data is read from disk on every request. Python 3.8+, standard library only.
"""

import argparse
import datetime
import difflib
import hmac
import http.server
import ipaddress
import json
import os
import platform
import re
import secrets
import signal
import shutil
import socket
import socketserver
import subprocess
import sys
import time
import urllib.parse
import webbrowser

VERSION = "1.4.1"
ARCHIVE = "_archive"
TIPS = "_tips"  # tips store (skills/handoff/tips.sh), not a project
GOAL_MAX = 200
NEXT_MAX = 3
PORT_TRIES = 10
LOOPBACK = {"127.0.0.1", "localhost", "::1"}


def handoff_root():
    root = os.environ.get("HANDOFF_ROOT")
    if not root:
        config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
        root = os.path.join(config, "handoffs")
    return root


# --- parsing ------------------------------------------------------------------

def parse_frontmatter(lines):
    """Returns (fields, index of the first body line)."""
    fields = {}
    if not lines or lines[0].strip() != "---":
        return fields, 0
    for i in range(1, len(lines)):
        line = lines[i]
        if line.strip() == "---":
            return fields, i + 1
        key, sep, value = line.partition(": ")
        if sep and key and key not in fields:
            fields[key.strip()] = value.strip()
    return {}, 0  # unterminated: treat the whole file as body


def section(body, name):
    """Lines of the `## name` section (up to the next `#`/`##` heading)."""
    out, inside = [], False
    for line in body:
        if re.match(r"#{1,2}\s", line):
            if inside:
                break
            inside = line.lstrip("#").strip().lower() == name
            continue
        if inside:
            out.append(line)
    return out


def first_paragraph(lines, limit):
    para = []
    for line in lines:
        if line.strip():
            para.append(line.strip())
        elif para:
            break
    text = " ".join(para)
    if len(text) > limit:
        text = text[:limit].rsplit(" ", 1)[0].rstrip(" ,.;:") + "…"
    return text


def list_items(lines):
    """Top-level items of a markdown list; indented lines continue an item."""
    items = []
    for line in lines:
        m = re.match(r"(\d+[.)]|[-*+])\s+(.*)", line)
        if m:
            items.append(m.group(2).strip())
        elif items and line.strip() and line[:1] in " \t":
            items[-1] += " " + line.strip()
    return items


def iso_created(created, filename):
    """ISO 8601 time: from the frontmatter, else from the file name (local time)."""
    for value, fmt in ((created, "%Y-%m-%d %H:%M:%S %z"), (filename[:17], "%Y-%m-%d_%H%M%S")):
        try:
            return datetime.datetime.strptime(value, fmt).isoformat()
        except (TypeError, ValueError):
            pass
    return ""


def own_repo(fields):
    """Git fields describe the project itself: the project directory is the
    repository, or a worktree of it (then `repo` is the main checkout)."""
    project, repo = fields.get("project", ""), fields.get("repo", "")
    if not project or repo in ("", "none"):
        return False
    return repo == project or (fields.get("dir") == project and os.path.exists(os.path.join(project, ".git")))


def read_task(task_dir, task, status):
    files = sorted(f for f in os.listdir(task_dir) if f.endswith(".md"))
    if not files:
        return None
    latest = files[-1]
    try:
        with open(os.path.join(task_dir, latest), encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None
    fields, start = parse_frontmatter(lines)
    body = lines[start:]
    steps = list_items(section(body, "next steps"))
    project = fields.get("project", "")
    none = lambda v: "" if v in (None, "none") else v  # noqa: E731
    parent = fields.get("from", "")
    return {
        "task": task,
        "status": status,
        "from": parent if TASK_RE.fullmatch(parent) and parent != ARCHIVE else "",
        "title": fields.get("title") or task,
        "project": project,
        "project_exists": bool(project) and os.path.isdir(project),
        "created": iso_created(fields.get("created"), latest),
        "saved": latest[:-3],
        "versions": len(files),
        "goal": first_paragraph(section(body, "goal"), GOAL_MAX),
        "next": steps[:NEXT_MAX],
        "next_more": max(0, len(steps) - NEXT_MAX),
        "repo": none(fields.get("repo")),
        "branch": none(fields.get("branch")),
        "commit": none(fields.get("commit"))[:7],
        "dir": none(fields.get("dir")),
        "git": own_repo(fields),
    }


def task_dir(root, slug, status, task):
    """Directory of a listed task, or None. Names are matched against directory
    listings, never joined from user input directly."""
    if slug not in projects(root):
        return None
    base = os.path.join(root, slug, ARCHIVE) if status == "archived" else os.path.join(root, slug)
    names = subdirs(base)
    if task not in names or (status != "archived" and task == ARCHIVE):
        return None
    return os.path.join(base, task)


def versions(d):
    try:
        return sorted(f for f in os.listdir(d) if f.endswith(".md")) if d else []
    except OSError:
        return []


def read_lines(d, name):
    try:
        with open(os.path.join(d, name), encoding="utf-8", errors="replace") as fh:
            return fh.read().splitlines()
    except OSError:
        return None


def pick(files, name):
    """`name` if it is one of `files`, the latest file if `name` is empty, else None."""
    if not files:
        return None
    if not name:
        return files[-1]
    return name if name in files else None


def read_body(root, slug, status, task, name=""):
    """Markdown body (without frontmatter) of one handoff of a task (default: the latest)."""
    d = task_dir(root, slug, status, task)
    name = pick(versions(d), name)
    lines = read_lines(d, name) if name else None
    if lines is None:
        return None
    _, start = parse_frontmatter(lines)
    return {"file": name, "body": "\n".join(lines[start:]).strip("\n")}


def history(root, slug, status, task):
    d = task_dir(root, slug, status, task)
    out = []
    for name in reversed(versions(d)):
        fields, _ = parse_frontmatter(read_lines(d, name) or [])
        out.append({"file": name, "title": fields.get("title") or task,
                    "created": iso_created(fields.get("created"), name)})
    return out if d else None


def diff(root, slug, status, task, old, new):
    d = task_dir(root, slug, status, task)
    files = versions(d)
    if not old or not new or pick(files, old) is None or pick(files, new) is None:
        return None
    def body(name):
        lines = read_lines(d, name) or []
        return lines[parse_frontmatter(lines)[1]:]
    lines = difflib.unified_diff(body(old), body(new), old, new, lineterm="", n=2)
    return {"old": old, "new": new, "diff": "\n".join(lines)}


def search(root, query):
    """Tasks whose latest handoff contains `query` (case-insensitive), with a snippet."""
    q = query.strip().lower()
    hits = []
    if len(q) < 2:
        return hits
    for slug in projects(root):
        base = os.path.join(root, slug)
        dirs = [(n, "active", os.path.join(base, n)) for n in subdirs(base) if n != ARCHIVE]
        dirs += [(n, "archived", os.path.join(base, ARCHIVE, n)) for n in subdirs(os.path.join(base, ARCHIVE))]
        for task, status, d in dirs:
            name = pick(versions(d), "")
            text = "\n".join(read_lines(d, name) or []) if name else ""
            i = text.lower().find(q)
            if i >= 0:
                s = max(0, i - 60)
                snippet = " ".join(text[s:i + len(q) + 60].split())
                hits.append({"slug": slug, "status": status, "task": task,
                             "snippet": ("…" if s else "") + snippet + "…"})
    return hits


def move_task(root, slug, task, archive):
    """Archive (`done`) or restore a task, merging into an existing directory,
    like `handoff.sh done|restore`. Returns an error message or None."""
    src = task_dir(root, slug, "active" if archive else "archived", task)
    if not src:
        return "no such task"
    files = versions(src)
    if not files:
        return "no handoffs saved"
    base = os.path.join(root, slug)
    dst = os.path.join(base, ARCHIVE, task) if archive else os.path.join(base, task)
    try:
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            os.replace(src, dst)
            return None
        for f in files:  # a task with this name exists there: merge the handoffs
            os.replace(os.path.join(src, f), os.path.join(dst, f))
    except OSError as e:
        return str(e)
    shutil.rmtree(src, ignore_errors=True)  # leftovers such as .DS_Store
    return None


TASK_RE = re.compile(r"[a-z0-9][a-z0-9._-]*")


def rename_task(root, slug, status, task, new):
    """Rename a task (active or archived) in place and update the `task:` field
    of its handoffs and the `from:` field of its forks. Refuses names taken by
    an active or archived task. Returns an error message or None."""
    src = task_dir(root, slug, status, task)
    if not src:
        return "no such task"
    if not TASK_RE.fullmatch(new) or new == ARCHIVE:
        return "invalid name (use lowercase a-z0-9._-)"
    if new == task:
        return None
    base = os.path.join(root, slug)
    if any(os.path.exists(os.path.join(d, new)) for d in (base, os.path.join(base, ARCHIVE))):
        return "@%s already exists" % new
    dst = os.path.join(os.path.dirname(src), new)
    try:
        os.rename(src, dst)
    except OSError as e:
        return str(e)
    for name in versions(dst):
        set_field(os.path.join(dst, name), "task", new)
    for d in (base, os.path.join(base, ARCHIVE)):
        for child in subdirs(d):
            for name in versions(os.path.join(d, child)) if child != ARCHIVE else []:
                set_field(os.path.join(d, child, name), "from", new, old=task)
    return None


def set_field(path, key, new, old=None):
    """Rewrite a frontmatter line (`task:`, `from:`) of a handoff, only if its
    value is `old` when given, keeping everything else byte for byte (line
    endings, mtime). Best effort: the directory name is what counts."""
    try:
        with open(path, "rb") as fh:
            lines = fh.read().splitlines(keepends=True)
        if not lines or lines[0].strip() != b"---":
            return
        for i in range(1, len(lines)):
            if lines[i].strip() == b"---":
                return  # no such field
            prefix = key.encode() + b": "
            if lines[i].startswith(prefix):
                body = lines[i].rstrip(b"\r\n")
                if old is not None and body[len(prefix):] != old.encode():
                    return
                lines[i] = prefix + new.encode() + lines[i][len(body):]
                break
        else:
            return  # unterminated frontmatter
        st = os.stat(path)
        tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
        with open(tmp, "wb") as fh:
            fh.write(b"".join(lines))
        os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.replace(tmp, path)
    except OSError:
        pass


def subdirs(path):
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [n for n in names if not n.startswith(".") and os.path.isdir(os.path.join(path, n))]


def projects(root):
    return [n for n in subdirs(root) if n != TIPS]


def collect(root):
    tasks = []
    for slug in projects(root):
        base = os.path.join(root, slug)
        for name in subdirs(base):
            if name == ARCHIVE:
                for arch in subdirs(os.path.join(base, ARCHIVE)):
                    tasks.append((slug, read_task(os.path.join(base, ARCHIVE, arch), arch, "archived")))
            else:
                tasks.append((slug, read_task(os.path.join(base, name), name, "active")))
    out = []
    for slug, t in tasks:
        if t:
            t["slug"] = slug
            t["project"] = t["project"] or slug
            out.append(t)
    out.sort(key=lambda t: t["saved"], reverse=True)
    return {"root": root, "home": os.path.expanduser("~"), "version": VERSION, "tasks": out,
            "tips": collect_tips(root)}


# --- tips (files written by skills/handoff/tips.sh) ---------------------------

GLOBAL = "_global"
TIP_FIELDS = ("title", "when", "keywords", "env", "origin", "status", "last_verified",
              "refuted", "superseded_by")


def tip_files(root, slug):
    """Tip ids of one tips directory (a project slug or `_global`)."""
    d = os.path.join(root, TIPS, slug)
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    return [n[:-3] for n in names if n.endswith(".md") and TASK_RE.fullmatch(n[:-3])
            and os.path.isfile(os.path.join(d, n))]


def collect_tips(root):
    tips = []
    for slug in subdirs(os.path.join(root, TIPS)):
        for tid in tip_files(root, slug):
            path = os.path.join(root, TIPS, slug, tid + ".md")
            lines = read_lines(os.path.dirname(path), tid + ".md")
            if lines is None:
                continue
            fields, start = parse_frontmatter(lines)
            tip = {k: fields.get(k, "") for k in TIP_FIELDS}
            tip.update({"slug": slug, "id": tid, "level": "global" if slug == GLOBAL else "project",
                        "title": tip["title"] or tid, "status": tip["status"] or "active",
                        "body": "\n".join(lines[start:]).strip("\n"), "file": path,
                        "modified": datetime.datetime.fromtimestamp(os.path.getmtime(path)).astimezone().isoformat()})
            tips.append(tip)
    stats = tip_stats(root, {(t["slug"], t["id"]) for t in tips})
    for t in tips:
        t["stats"] = stats.get((t["slug"], t["id"]), {})
    return tips


OFFERED = {"hook", "prompt-hook", "search"}  # the tip was listed to the agent
STAT_KEYS = {"show": "opened", "verified": "verified", "refuted": "refuted"}


def tip_stats(root, known):
    """Counts log events per tip: offered, opened, verified, refuted, last (ts)."""
    stats = {}
    for name in ("log.1.jsonl", "log.jsonl"):
        try:
            with open(os.path.join(root, TIPS, name), encoding="utf-8") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for line in lines:
            try:
                ev = json.loads(line)
                kind, slug, ts = ev["event"], ev.get("project", ""), ev.get("ts", "")
                ids = [i for i in str(ev.get("id") or "").split(",") if i]
            except (ValueError, KeyError, TypeError, AttributeError):
                continue
            key = "offered" if kind in OFFERED else STAT_KEYS.get(kind)
            if not key:
                continue
            for tid in ids:
                # The event's project is the session's; the tip may be global.
                tip = (slug, tid) if (slug, tid) in known else (GLOBAL, tid)
                if tip not in known:
                    continue
                s = stats.setdefault(tip, {})
                s[key] = s.get(key, 0) + 1
                s["last"] = max(s.get("last", ""), ts)
    return stats


def delete_tip(root, slug, tid):
    """Delete one tip file, logged like tips.sh does. Returns an error message or None."""
    if slug not in subdirs(os.path.join(root, TIPS)) or tid not in tip_files(root, slug):
        return "no such tip"
    try:
        os.remove(os.path.join(root, TIPS, slug, tid + ".md"))
    except OSError as e:
        return str(e)
    event = {"ts": datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z"),
             "event": "deleted", "project": slug, "id": tid, "hits": 0, "via": "dashboard"}
    try:
        with open(os.path.join(root, TIPS, "log.jsonl"), "a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass
    return None


# --- server -------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "handoffs/" + VERSION
    allowed_hosts = LOOPBACK
    any_ip = False  # listening on 0.0.0.0/::: any IP address is a valid Host
    token = ""  # empty: read-only

    def host_ok(self):
        host = (self.headers.get("Host") or "").strip().lower()
        if host.startswith("["):
            host = host[1:].split("]", 1)[0]
        elif host.count(":") == 1:
            host = host.split(":", 1)[0]
        if host in self.allowed_hosts:
            return True
        if self.any_ip:
            try:
                ipaddress.ip_address(host)
                return True
            except ValueError:
                return False
        return False

    def send(self, code, ctype, body):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                         "connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; "
                         "frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, obj, code=200):
        return self.send(code, "application/json; charset=utf-8", json.dumps(obj, ensure_ascii=False))

    def not_found(self):
        return self.send(404, "text/plain; charset=utf-8", "not found\n")

    def do_GET(self):  # noqa: N802 (http.server API)
        if not self.host_ok():
            return self.send(403, "text/plain; charset=utf-8", "forbidden host\n")
        path, _, query = self.path.partition("?")
        q = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
        key = (handoff_root(), q.get("slug", ""), q.get("status", ""), q.get("task", ""))
        if path in ("/", "/index.html"):
            return self.send(200, "text/html; charset=utf-8", PAGE.replace("__TOKEN__", self.token))
        if path == "/api/tasks":
            data = collect(handoff_root())
            data["writable"] = bool(self.token)
            return self.send_json(data)
        if path == "/api/search":
            return self.send_json(search(handoff_root(), q.get("q", "")[:200]))
        result = None
        if path == "/api/handoff":
            result = read_body(*key, name=q.get("file", ""))
        elif path == "/api/history":
            result = history(*key)
        elif path == "/api/diff":
            result = diff(*key, q.get("old", ""), q.get("new", ""))
        return self.not_found() if result is None else self.send_json(result)

    def do_POST(self):  # noqa: N802 (http.server API)
        if not self.host_ok():
            return self.send(403, "text/plain; charset=utf-8", "forbidden host\n")
        origin = self.headers.get("Origin")
        host = self.headers.get("Host") or ""
        if not self.token or not hmac.compare_digest(self.headers.get("X-Handoffs-Token") or "", self.token) \
                or (origin and origin != "http://" + host):
            return self.send_json({"error": "forbidden"}, 403)
        path = self.path.split("?", 1)[0]
        if path not in ("/api/done", "/api/restore", "/api/rename", "/api/tip/delete"):
            return self.not_found()
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 4096)) or b"{}")
            slug = str(body["slug"])
            if path == "/api/tip/delete":
                tid = str(body["id"])
            else:
                task = str(body["task"])
            if path == "/api/rename":
                status, new = str(body["status"]), str(body["new"])
        except (ValueError, KeyError, TypeError):
            return self.send_json({"error": "bad request"}, 400)
        if path == "/api/tip/delete":
            err = delete_tip(handoff_root(), slug, tid)
        elif path == "/api/rename":
            err = rename_task(handoff_root(), slug, status, task, new)
        else:
            err = move_task(handoff_root(), slug, task, archive=path == "/api/done")
        return self.send_json({"error": err}, 409) if err else self.send_json({"ok": True})

    def log_message(self, *args):
        pass


def make_server(host, port):
    family = socket.AF_INET6 if ":" in host else socket.AF_INET

    class Server(http.server.ThreadingHTTPServer):
        address_family = family
        allow_reuse_address = os.name != "nt"  # on Windows it lets two servers share a port
        daemon_threads = True

        def server_bind(self):
            # HTTPServer.server_bind calls socket.getfqdn(), which can take
            # seconds (reverse DNS on macOS); the name is never used here.
            socketserver.TCPServer.server_bind(self)
            self.server_name, self.server_port = self.server_address[:2]

    last = None
    for p in range(port, port + PORT_TRIES) if port else [0]:
        try:
            return Server((host, p), Handler)
        except OSError as e:
            last = e
    raise SystemExit("error: cannot listen on %s:%s-%s (%s)" % (host, port, port + PORT_TRIES - 1, last))


# --- browser ------------------------------------------------------------------

def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def open_browser(url):
    """Best effort; returns False when the URL should just be opened by hand."""
    env = os.environ
    if env.get("SSH_CONNECTION") or env.get("SSH_TTY"):
        return False
    if env.get("TERMUX_VERSION") or "com.termux" in env.get("PREFIX", ""):
        return bool(shutil.which("termux-open-url")) and spawn(["termux-open-url", url])
    if sys.platform.startswith("linux"):
        if env.get("WSL_DISTRO_NAME") or "microsoft" in platform.release().lower():
            if shutil.which("wslview"):
                return spawn(["wslview", url])
            return bool(shutil.which("explorer.exe")) and spawn(["explorer.exe", url])
        if not (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")):
            return False  # no GUI: webbrowser could start a text browser in this terminal
    try:
        return webbrowser.open(url)
    except Exception:  # noqa: BLE001 (any browser failure means "open by hand")
        return False


# --- background & service -----------------------------------------------------

PIDFILE = ".handoffs.pid"  # "<pid> <url>" of a --background dashboard
LABEL = "com.claude-handoff.handoffs"


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_pidfile(path):
    try:
        with open(path, encoding="utf-8") as fh:
            pid, _, url = fh.read().strip().partition(" ")
        pid = int(pid)
    except (OSError, ValueError):
        return None, ""
    return (pid, url) if pid_alive(pid) else (None, "")


def start_background(argv, no_open):
    """Re-run the dashboard detached, wait for its URL line, record the PID."""
    root = handoff_root()
    os.makedirs(root, exist_ok=True)
    pidfile = os.path.join(root, PIDFILE)
    pid, url = read_pidfile(pidfile)
    if pid:
        print("handoffs: already running at %s (pid %d; handoffs --stop)" % (url, pid))
        return 0
    log = os.path.join(root, ".handoffs.log")
    args = [a for a in argv if a != "--background"] + ["--no-open"]
    with open(log, "w", encoding="utf-8") as out:
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__)] + args,
                                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                start_new_session=True)
    url = ""
    for _ in range(300):  # up to 15 s
        try:
            with open(log, encoding="utf-8") as fh:
                m = re.search(r"^handoffs: (\S+)", fh.read(), re.M)
        except OSError:
            m = None
        if m:
            url = m.group(1)
            break
        if proc.poll() is not None:
            break
        time.sleep(0.05)
    if not url:
        with open(log, encoding="utf-8") as fh:
            sys.stderr.write(fh.read())
        if proc.poll() is None:
            proc.terminate()
        print("error: the dashboard did not start (log: %s)" % log, file=sys.stderr)
        return 1
    with open(pidfile, "w", encoding="utf-8") as fh:
        fh.write("%d %s\n" % (proc.pid, url))
    print("handoffs: %s  (pid %d; handoffs --stop to stop)" % (url, proc.pid))
    if not no_open and not open_browser(url):
        print("open the URL above in a browser")
    return 0


def stop_background():
    pidfile = os.path.join(handoff_root(), PIDFILE)
    pid, _ = read_pidfile(pidfile)
    if os.path.exists(pidfile):
        os.remove(pidfile)
    if not pid:
        print("handoffs: no background dashboard is running")
        return 1
    os.kill(pid, signal.SIGTERM)
    print("handoffs: stopped (pid %d)" % pid)
    return 0


def service_kind():
    if sys.platform == "darwin":
        return "launchd"
    if sys.platform.startswith("linux") and shutil.which("systemctl") and not os.environ.get("TERMUX_VERSION"):
        return "systemd"
    return ""


def service_path(kind):
    home = os.path.expanduser("~")
    if kind == "launchd":
        return os.path.join(home, "Library", "LaunchAgents", LABEL + ".plist")
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    return os.path.join(cfg, "systemd", "user", "handoffs.service")


def service_env():
    return {k: os.environ[k] for k in ("HANDOFF_ROOT", "CLAUDE_CONFIG_DIR", "HANDOFF_PORT") if os.environ.get(k)}


def systemd_quote(s):
    if s and not re.search(r'[\s"\\\'$%;]', s):
        return s
    return '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"').replace("$", "$$").replace("%", "%%")


def service_file(kind, cmd, env):
    if kind == "systemd":
        lines = ["[Unit]", "Description=claude-handoff dashboard (handoffs)", "", "[Service]",
                 "ExecStart=" + " ".join(systemd_quote(c) for c in cmd)]
        lines += ["Environment=" + systemd_quote("%s=%s" % kv) for kv in sorted(env.items())]
        lines += ["Restart=on-failure", "", "[Install]", "WantedBy=default.target", ""]
        return "\n".join(lines)
    from xml.sax.saxutils import escape
    s = lambda v: "<string>%s</string>" % escape(v)  # noqa: E731
    logf = os.path.join(os.path.expanduser("~"), "Library", "Logs", "handoffs.log")
    out = ['<?xml version="1.0" encoding="UTF-8"?>',
           '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
           '<plist version="1.0">', "<dict>",
           "<key>Label</key>" + s(LABEL),
           "<key>ProgramArguments</key>", "<array>"] + ["  " + s(c) for c in cmd] + ["</array>"]
    if env:
        out += ["<key>EnvironmentVariables</key>", "<dict>"]
        out += ["  <key>%s</key>%s" % (escape(k), s(v)) for k, v in sorted(env.items())]
        out += ["</dict>"]
    out += ["<key>RunAtLoad</key><true/>", "<key>KeepAlive</key><true/>",
            "<key>StandardOutPath</key>" + s(logf), "<key>StandardErrorPath</key>" + s(logf),
            "</dict>", "</plist>", ""]
    return "\n".join(out)


def run(cmd, quiet=False):
    r = subprocess.run(cmd, stdout=subprocess.DEVNULL if quiet else None,
                       stderr=subprocess.DEVNULL if quiet else None)
    return r.returncode


def service_main(argv):
    ap = argparse.ArgumentParser(prog="handoffs service",
                                 description="Run the dashboard as a user service (systemd --user or launchd).")
    ap.add_argument("action", choices=["install", "uninstall", "restart", "status"])
    ap.add_argument("--port", type=int, help="port for the service (default: $HANDOFF_PORT or 8765)")
    ap.add_argument("--host", help="address to listen on (default: 127.0.0.1)")
    ap.add_argument("--read-only", action="store_true", help="serve the dashboard read-only")
    ap.add_argument("--dry-run", action="store_true", help="print the service file and commands; change nothing")
    args = ap.parse_args(argv)
    kind = os.environ.get("HANDOFF_SERVICE_KIND") or service_kind()  # override for tests
    if kind not in ("systemd", "launchd"):
        print("error: no systemd --user or launchd here; use `handoffs --background` instead", file=sys.stderr)
        return 2
    path = service_path(kind)
    uid = "gui/%d" % os.getuid()
    if kind == "systemd":
        cmds = {"install": [["systemctl", "--user", "daemon-reload"],
                            ["systemctl", "--user", "enable", "--now", "handoffs.service"],
                            ["systemctl", "--user", "restart", "handoffs.service"]],
                "uninstall": [["systemctl", "--user", "disable", "--now", "handoffs.service"]],
                "restart": [["systemctl", "--user", "try-restart", "handoffs.service"]],
                "status": [["systemctl", "--user", "--no-pager", "status", "handoffs.service"]]}
    else:
        cmds = {"install": [["launchctl", "bootout", uid, path], ["launchctl", "bootstrap", uid, path]],
                "uninstall": [["launchctl", "bootout", uid, path]],
                "restart": [["launchctl", "kickstart", "-k", "%s/%s" % (uid, LABEL)]],
                "status": [["launchctl", "print", "%s/%s" % (uid, LABEL)]]}
    installed = os.path.exists(path)

    if args.action == "install":
        cmd = [sys.executable, os.path.abspath(__file__), "--no-open"]
        if args.port is not None:
            cmd += ["--port", str(args.port)]
        if args.host:
            cmd += ["--host", args.host]
        if args.read_only:
            cmd += ["--read-only"]
        text = service_file(kind, cmd, service_env())
        if args.dry_run:
            print("# %s" % path)
            sys.stdout.write(text)
            for c in cmds["install"]:
                print("$ " + " ".join(c))
            return 0
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
        print("wrote %s" % path)
        if kind == "launchd":
            run(cmds["install"][0], quiet=True)  # not loaded yet is fine
            rc = run(cmds["install"][1])
        else:
            rc = run(cmds["install"][0]) or run(cmds["install"][1]) or run(cmds["install"][2])
        if rc:
            return rc
        print("handoffs service is running: http://127.0.0.1:%s/" % (args.port or os.environ.get("HANDOFF_PORT") or 8765))
        if kind == "systemd":
            print("note: to keep it running while logged out: loginctl enable-linger")
        return 0

    if not installed:
        if args.action == "restart":
            return 0  # nothing to restart (install.sh calls this after an upgrade)
        print("handoffs service is not installed (handoffs service install)")
        return 1 if args.action == "status" else 0
    if args.dry_run:
        for c in cmds[args.action]:
            print("$ " + " ".join(c))
        if args.action == "uninstall":
            print("$ rm " + path)
        return 0
    if args.action == "uninstall":
        run(cmds["uninstall"][0])
        os.remove(path)
        if kind == "systemd":
            run(["systemctl", "--user", "daemon-reload"])
        print("removed %s" % path)
        return 0
    return run(cmds[args.action][0])


# --- main ---------------------------------------------------------------------

def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["service"]:
        return service_main(argv[1:])
    ap = argparse.ArgumentParser(prog="handoffs", description="Local web dashboard for claude-handoff tasks.")
    env_port = os.environ.get("HANDOFF_PORT") or "8765"
    if not env_port.isdigit() or int(env_port) > 65535:
        print("error: HANDOFF_PORT must be a port number (0-65535), got %r" % env_port, file=sys.stderr)
        return 2
    ap.add_argument("--port", type=int, default=int(env_port),
                    help="port to listen on; the next %d are tried if it is busy, 0 picks any "
                         "(default: $HANDOFF_PORT or 8765)" % (PORT_TRIES - 1))
    ap.add_argument("--host", default="127.0.0.1", help="address to listen on (default: 127.0.0.1)")
    ap.add_argument("--no-open", action="store_true", help="do not open a browser")
    ap.add_argument("--read-only", action="store_true", help="disable Done/Restore/Rename and Delete buttons")
    ap.add_argument("--background", action="store_true", help="run detached and return (stop: --stop)")
    ap.add_argument("--stop", action="store_true", help="stop the dashboard started with --background")
    ap.add_argument("--json", action="store_true", help="print the task data as JSON and exit")
    ap.add_argument("--version", action="version", version="handoffs " + VERSION)
    args = ap.parse_args(argv)

    if args.json:
        json.dump(collect(handoff_root()), sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if args.stop:
        return stop_background()
    if args.background:
        return start_background(argv, args.no_open)

    host = args.host.strip("[]")
    if host not in LOOPBACK:
        Handler.allowed_hosts = LOOPBACK | {host.lower()}
        Handler.any_ip = host in ("0.0.0.0", "::")
        print("warning: listening on %s; other machines may reach the dashboard" % host, file=sys.stderr)
    if not args.read_only:
        Handler.token = secrets.token_urlsafe(24)
    server = make_server(host, args.port)
    port = server.server_address[1]
    shown = "127.0.0.1" if host in ("0.0.0.0", "::") else host
    url = "http://%s:%d/" % ("[%s]" % shown if ":" in shown else shown, port)
    hint = "; Ctrl+C to stop" if sys.stdout.isatty() else ""  # not under a service or --background
    print("handoffs: %s  (root: %s%s)" % (url, handoff_root(), hint), flush=True)
    if not args.no_open and not open_browser(url):
        print("open the URL above in a browser", flush=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))  # service/--stop: close the socket cleanly
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        server.server_close()
    return 0


