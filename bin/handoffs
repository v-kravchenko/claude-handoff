#!/usr/bin/env python3
"""Local web dashboard for claude-handoff tasks (part of claude-handoff).

Usage: handoffs [--port N] [--host ADDR] [--no-open] [--background | --stop]
                [--json] [--version]
       handoffs service install|uninstall|restart|status [--port N] [--dry-run]
       handoffs auth status|on|off|password [--generate|--stdin]|logout-all
       handoffs paths [--prune]

Serves a page with every task of every project under the handoff
root ($HANDOFF_ROOT, else `root=` in ~/.config/claude-handoff/config, else
$XDG_DATA_HOME/claude-handoff, else ~/.local/share/claude-handoff). Logs and the PID file are per machine, in
$HANDOFF_STATE (else $XDG_STATE_HOME/claude-handoff, else
~/.local/state/claude-handoff), like this machine's project paths
(`paths`, recorded by /handoff and /pickup; `path.<key> =` in the config
file overrides one): a project's path is that one if it exists, else the
newest `project:` of its handoffs that exists here.
Data is read from disk on every request. Python 3.8+, standard library only.
Whoever can open the dashboard can edit it: with `auth = off` (the default)
it listens on loopback only; `handoffs auth on` adds a password login, for a
dashboard on another address or behind an HTTPS proxy (`public_url =`).
"""

import argparse
import base64
import datetime
import difflib
import getpass
import hashlib
import hmac
import http.server
import ipaddress
import json
import os
import platform
import re
import secrets
import signal
import shutil
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse
import webbrowser

VERSION = "1.5.5"
ARCHIVE = "_archive"
HISTORY = "_history"  # older handoffs: <slug>/_history/<task>/<stamp>.md
TIPS = "_tips"  # tips store (skills/handoff/tips.sh), not a project
DESC = "_project.md"  # a project's description (handoff.sh describe)
GOAL_MAX = 200
NEXT_MAX = 3
PORT_TRIES = 10
LOOPBACK = {"127.0.0.1", "localhost", "::1"}


def config_path():
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(os.path.expanduser("~"), ".config")
    return os.environ.get("HANDOFF_CONFIG") or os.path.join(cfg, "claude-handoff", "config")


def expand_home(path):
    return os.path.expanduser(path) if path == "~" or path.startswith("~/") else path


def config_values():
    """`name = value` lines of the config file (the last one wins)."""
    values = {}
    try:
        with open(config_path(), encoding="utf-8") as fh:
            for line in fh:
                key, sep, value = line.partition("=")
                if sep:
                    values[key.strip()] = value.strip()
    except OSError:
        pass
    return values


def config_root():
    """`root=` from the config file, or ""."""
    return expand_home(config_values().get("root", ""))


def handoff_root():
    root = os.environ.get("HANDOFF_ROOT") or config_root()
    if not root:
        data = os.environ.get("XDG_DATA_HOME") or os.path.join(os.path.expanduser("~"), ".local", "share")
        root = os.path.join(data, "claude-handoff")
    return root


def state_dir():
    """Per-machine files (logs, PID file); the root holds only .md files."""
    d = os.environ.get("HANDOFF_STATE")
    if not d:
        st = os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state")
        d = os.path.join(st, "claude-handoff")
    return d


PATHS = "paths"


def read_paths():
    """This machine's project paths: key -> path, from `new`/`show` of
    handoff.sh ($HANDOFF_STATE/paths)."""
    out = {}
    try:
        with open(os.path.join(state_dir(), PATHS), encoding="utf-8") as fh:
            for line in fh:
                key, sep, path = line.rstrip("\n").partition("\t")
                if sep and key and path:
                    out[key] = path
    except OSError:
        pass
    return out


def config_paths():
    """Key -> path from `path.<key> =` lines of the config file."""
    return {n[5:]: expand_home(v) for n, v in config_values().items() if n.startswith("path.") and n[5:] and v}


def machine_paths():
    """Key -> this machine's candidate paths of the project: `path.<key> =`
    in the config file, then the recorded one."""
    out = {}
    for paths in (config_paths(), read_paths()):
        for key, path in paths.items():
            out.setdefault(key, []).append(path)
    return out


def paths_main(argv):
    ap = argparse.ArgumentParser(prog="handoffs paths",
                                 description="This machine's project paths (the dashboard's `cd`).")
    ap.add_argument("--prune", action="store_true", help="forget the recorded paths that no longer exist")
    args = ap.parse_args(argv)
    recorded = read_paths()
    rows = [(k, p, "config") for k, p in config_paths().items()] + [(k, p, "") for k, p in recorded.items()]
    for key, path, kind in sorted(rows, key=lambda r: (r[0], r[2] != "config")):
        notes = [n for n in (kind, "" if os.path.isdir(path) else "missing") if n]
        print("%s\t%s%s" % (key, path, "  (%s)" % ", ".join(notes) if notes else ""))
    gone = [k for k, p in recorded.items() if not os.path.isdir(p)]
    if args.prune and gone:
        f = os.path.join(state_dir(), PATHS)
        tmp = "%s.%d.tmp" % (f, os.getpid())
        with open(tmp, "w", encoding="utf-8") as fh:
            fh.writelines("%s\t%s\n" % (k, p) for k, p in recorded.items() if k not in gone)
        os.replace(tmp, f)
        print("forgot: " + ", ".join(sorted(gone)))
    return 0


# --- parsing ------------------------------------------------------------------

def unquote(value, is_list=False):
    """A YAML "double" or 'single' quoted scalar, unquoted; for a list
    (keywords: [a, "b: c"]) only the brackets go, the items keep their quotes."""
    if is_list:
        return value[1:-1].strip() if value[:1] == "[" and value[-1:] == "]" else value
    if len(value) >= 2 and value[0] == value[-1] == '"':
        return re.sub(r'\\(["\\])', r"\1", value[1:-1])
    if len(value) >= 2 and value[0] == value[-1] == "'":
        return value[1:-1].replace("''", "'")
    return value


def parse_frontmatter(lines):
    """Returns (fields, index of the first body line)."""
    fields = {}
    if not lines or lines[0].strip() != "---":
        return fields, 0
    for i in range(1, len(lines)):
        line = lines[i]
        if line.strip() == "---":
            return fields, i + 1
        key, sep, value = line.partition(": ")
        if sep and key and key not in fields:
            fields[key.strip()] = unquote(value.strip(), key.strip() == "keywords")
    return {}, 0  # unterminated: treat the whole file as body


def section(body, name):
    """Lines of the `## name` section (up to the next `#`/`##` heading)."""
    out, inside = [], False
    for line in body:
        if re.match(r"#{1,2}\s", line):
            if inside:
                break
            inside = line.lstrip("#").strip().lower() == name
            continue
        if inside:
            out.append(line)
    return out


def first_paragraph(lines, limit):
    para = []
    for line in lines:
        if line.strip():
            para.append(line.strip())
        elif para:
            break
    text = " ".join(para)
    if len(text) > limit:
        text = text[:limit].rsplit(" ", 1)[0].rstrip(" ,.;:") + "…"
    return text


def list_items(lines):
    """Top-level items of a markdown list; indented lines continue an item."""
    items = []
    for line in lines:
        m = re.match(r"(\d+[.)]|[-*+])\s+(.*)", line)
        if m:
            items.append(m.group(2).strip())
        elif items and line.strip() and line[:1] in " \t":
            items[-1] += " " + line.strip()
    return items


def iso_created(created, filename):
    """ISO 8601 time: from the frontmatter, else from the file name (local time)."""
    for value, fmt in ((created, "%Y-%m-%d %H:%M:%S %z"), (filename[:17], "%Y-%m-%d_%H%M%S")):
        try:
            return datetime.datetime.strptime(value, fmt).isoformat()
        except (TypeError, ValueError):
            pass
    return ""


def own_repo(fields):
    """Git fields describe the project itself: the work happened in the
    project directory (a repository or a worktree), not in a subdirectory.
    Since 1.5.0 `dir` is relative to the project (`.` for it)."""
    project = fields.get("project", "")
    return bool(project) and fields.get("dir") in (".", project) and \
        fields.get("commit") not in (None, "", "none")


def stamp(path, fields=None):
    """YYYY-MM-DD_HHMMSS of a handoff: from its `created`, else its mtime."""
    if fields is None:
        fields, _ = parse_frontmatter(read_lines(os.path.dirname(path), os.path.basename(path)) or [])
    m = re.match(r"(\d{4}-\d\d-\d\d) (\d\d):(\d\d):(\d\d)", fields.get("created") or "")
    if m:
        return "%s_%s%s%s" % m.groups()
    try:
        return datetime.datetime.fromtimestamp(os.path.getmtime(path)).strftime("%Y-%m-%d_%H%M%S")
    except OSError:
        return "0000-00-00_000000"


def read_task(base, task, status, slug_dir):
    path = os.path.join(base, task + ".md")
    lines = read_lines(base, task + ".md")
    if lines is None:
        return None
    fields, start = parse_frontmatter(lines)
    body = lines[start:]
    steps = list_items(section(body, "next steps"))
    project = fields.get("project", "")
    none = lambda v: "" if v in (None, "none") else v  # noqa: E731
    parent = fields.get("from", "")
    saved = stamp(path, fields)
    return {
        "task": task,
        "status": status,
        "from": parent if TASK_RE.fullmatch(parent) else "",
        "title": fields.get("title") or task,
        "project": project,
        "project_exists": bool(project) and os.path.isdir(project),
        "created": iso_created(fields.get("created"), saved),
        "saved": saved,
        "versions": len(md_files(os.path.join(slug_dir, HISTORY, task))) + 1,
        "goal": first_paragraph(section(body, "goal"), GOAL_MAX),
        "next": steps[:NEXT_MAX],
        "next_more": max(0, len(steps) - NEXT_MAX),
        "branch": none(fields.get("branch")),
        "commit": none(fields.get("commit"))[:7],
        "dir": none(fields.get("dir")),
        "git": own_repo(fields),
    }


def md_files(d):
    try:
        return sorted(f for f in os.listdir(d) if f.endswith(".md") and os.path.isfile(os.path.join(d, f)))
    except OSError:
        return []


def task_names(d):
    """Tasks stored in d (a project or its _archive): <task>.md files."""
    return [f[:-3] for f in md_files(d) if TASK_RE.fullmatch(f[:-3])]


def task_base(root, slug, status, task):
    """Directory holding a listed task's file, or None. Names are matched
    against directory listings, never joined from user input directly."""
    if slug not in projects(root):
        return None
    base = os.path.join(root, slug, ARCHIVE) if status == "archived" else os.path.join(root, slug)
    return base if task in task_names(base) else None


def versions(root, slug, status, task):
    """(name, directory) of every handoff of a task, oldest first: the history,
    then the task's file. Returns [] for an unknown task."""
    base = task_base(root, slug, status, task)
    if not base:
        return []
    hist = os.path.join(root, slug, HISTORY, task)
    return [(f, hist) for f in md_files(hist)] + [(task + ".md", base)]


def read_lines(d, name):
    try:
        with open(os.path.join(d, name), encoding="utf-8", errors="replace") as fh:
            return fh.read().splitlines()
    except OSError:
        return None


def pick(files, name):
    """(name, dir) for `name` if it is one of `files`, the latest if `name` is
    empty, else None."""
    if not files:
        return None
    if not name:
        return files[-1]
    return next((f for f in files if f[0] == name), None)


def read_body(root, slug, status, task, name=""):
    """Markdown body (without frontmatter) of one handoff of a task (default: the latest)."""
    f = pick(versions(root, slug, status, task), name)
    lines = read_lines(f[1], f[0]) if f else None
    if lines is None:
        return None
    _, start = parse_frontmatter(lines)
    return {"file": f[0], "body": "\n".join(lines[start:]).strip("\n")}


def history(root, slug, status, task):
    files = versions(root, slug, status, task)
    out = []
    for name, d in reversed(files):
        fields, _ = parse_frontmatter(read_lines(d, name) or [])
        out.append({"file": name, "title": fields.get("title") or task,
                    "created": iso_created(fields.get("created"), stamp(os.path.join(d, name), fields))})
    return out if files else None


def diff(root, slug, status, task, old, new):
    files = versions(root, slug, status, task)
    a, b = pick(files, old) if old else None, pick(files, new) if new else None
    if not a or not b:
        return None
    def body(f):
        lines = read_lines(f[1], f[0]) or []
        return lines[parse_frontmatter(lines)[1]:]
    lines = difflib.unified_diff(body(a), body(b), old, new, lineterm="", n=2)
    return {"old": old, "new": new, "diff": "\n".join(lines)}


def search(root, query):
    """Tasks whose latest handoff contains `query` (case-insensitive), with a snippet."""
    q = query.strip().lower()
    hits = []
    if len(q) < 2:
        return hits
    for slug in projects(root):
        base = os.path.join(root, slug)
        for status, d in (("active", base), ("archived", os.path.join(base, ARCHIVE))):
            for task in task_names(d):
                text = "\n".join(read_lines(d, task + ".md") or [])
                i = text.lower().find(q)
                if i >= 0:
                    s = max(0, i - 60)
                    snippet = " ".join(text[s:i + len(q) + 60].split())
                    hits.append({"slug": slug, "status": status, "task": task,
                                 "snippet": ("…" if s else "") + snippet + "…"})
    return hits


def to_history(root, slug, task, path):
    """Move a handoff into the task's history, named by its stamp."""
    d = os.path.join(root, slug, HISTORY, task)
    os.makedirs(d, exist_ok=True)
    s = stamp(path)
    dst, n = os.path.join(d, s + ".md"), 0
    while os.path.exists(dst):
        n += 1
        dst = os.path.join(d, "%s_%d.md" % (s, n))
    os.replace(path, dst)


def move_task(root, slug, task, archive):
    """Archive (`done`) or restore a task, like `handoff.sh done|restore`: a
    task file already there goes to the history. Returns an error message or None."""
    src = task_base(root, slug, "active" if archive else "archived", task)
    if not src:
        return "no such task"
    base = os.path.join(root, slug)
    dst = os.path.join(base, ARCHIVE) if archive else base
    try:
        if os.path.exists(os.path.join(dst, task + ".md")):
            to_history(root, slug, task, os.path.join(dst, task + ".md"))
        os.makedirs(dst, exist_ok=True)
        os.replace(os.path.join(src, task + ".md"), os.path.join(dst, task + ".md"))
    except OSError as e:
        return str(e)
    return None


TASK_RE = re.compile(r"[a-z0-9][a-z0-9._-]*")


def rename_task(root, slug, status, task, new):
    """Rename a task (active or archived) in place, with its history, and
    update the `task:` field of its handoffs and the `from:` field of its
    forks. Refuses names taken by an active or archived task or a history.
    Returns an error message or None."""
    src = task_base(root, slug, status, task)
    if not src:
        return "no such task"
    if not TASK_RE.fullmatch(new):
        return "invalid name (use lowercase a-z0-9._-)"
    if new == task:
        return None
    base = os.path.join(root, slug)
    hist = os.path.join(base, HISTORY)
    if any(os.path.exists(os.path.join(d, new + ".md")) for d in (base, os.path.join(base, ARCHIVE))) \
            or os.path.exists(os.path.join(hist, new)):
        return "@%s already exists" % new
    try:
        os.rename(os.path.join(src, task + ".md"), os.path.join(src, new + ".md"))
        if os.path.isdir(os.path.join(hist, task)):
            os.rename(os.path.join(hist, task), os.path.join(hist, new))
    except OSError as e:
        return str(e)
    set_field(os.path.join(src, new + ".md"), "task", new)
    for name in md_files(os.path.join(hist, new)):
        set_field(os.path.join(hist, new, name), "task", new)
    for d in (base, os.path.join(base, ARCHIVE)):
        for child in task_names(d):
            set_field(os.path.join(d, child + ".md"), "from", new, old=task)
    return None


def set_field(path, key, new, old=None):
    """Rewrite a frontmatter line (`task:`, `from:`) of a handoff, only if its
    value is `old` when given, keeping everything else byte for byte (line
    endings, mtime). Best effort: the directory name is what counts."""
    try:
        with open(path, "rb") as fh:
            lines = fh.read().splitlines(keepends=True)
        if not lines or lines[0].strip() != b"---":
            return
        for i in range(1, len(lines)):
            if lines[i].strip() == b"---":
                return  # no such field
            prefix = key.encode() + b": "
            if lines[i].startswith(prefix):
                body = lines[i].rstrip(b"\r\n")
                if old is not None and body[len(prefix):] != old.encode():
                    return
                lines[i] = prefix + new.encode() + lines[i][len(body):]
                break
        else:
            return  # unterminated frontmatter
        st = os.stat(path)
        tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
        with open(tmp, "wb") as fh:
            fh.write(b"".join(lines))
        os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.replace(tmp, path)
    except OSError:
        pass


def subdirs(path):
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [n for n in names if not n.startswith(".") and os.path.isdir(os.path.join(path, n))]


def projects(root):
    return [n for n in subdirs(root) if n != TIPS]


def collect(root):
    tasks = []
    for slug in projects(root):
        base = os.path.join(root, slug)
        for status, d in (("active", base), ("archived", os.path.join(base, ARCHIVE))):
            for task in task_names(d):
                tasks.append((slug, read_task(d, task, status, base)))
    out = [t for _, t in tasks if t]
    for (slug, t) in tasks:
        if t:
            t["slug"] = slug
    out.sort(key=lambda t: t["saved"], reverse=True)
    # One project per key, though its handoffs may come from other paths or
    # machines: its path is this machine's one (machine_paths) if it exists,
    # else the newest in the handoffs that exists here, else the newest.
    names, where, mine = {}, {}, machine_paths()
    for t in out:
        paths = where.setdefault(t["slug"], [])
        if t["project"] and t["project"] not in paths:
            paths.append(t["project"])
    for slug, paths in where.items():
        here = [p for p in mine.get(slug, []) + paths if os.path.isdir(p)]
        where[slug] = (here or paths or [slug])[0]
    for t in out:
        t["project"] = where[t["slug"]]
        t["project_exists"] = os.path.isdir(t["project"])
    tips = collect_tips(root)
    for slug in {t["slug"] for t in tips if t["slug"] != GLOBAL} - set(where):
        where[slug] = next((p for p in mine.get(slug, []) if os.path.isdir(p)), slug)
    for slug, path in where.items():
        names[path] = {"name": project_name(slug), "desc": describe(root, slug)}
    return {"root": root, "home": os.path.expanduser("~"), "version": VERSION, "tasks": out,
            "tips": tips, "projects": names}


def project_name(slug):
    """Display name of a key: q1~api -> q1/api; empty for an old path key
    (home~code~app), which is shown by its path."""
    if slug in ("home", "root") or slug.startswith(("home~", "root~")):
        return ""
    return slug.replace("~", "/")


def describe(root, slug):
    """The project's description (_project.md, written by `handoff.sh describe`)."""
    try:
        with open(os.path.join(root, slug, DESC), encoding="utf-8", errors="replace") as fh:
            return " ".join(fh.read().split())[:GOAL_MAX]
    except OSError:
        return ""


# --- tips (files written by skills/handoff/tips.sh) ---------------------------

GLOBAL = "_global"
TIP_FIELDS = ("title", "when", "keywords", "env", "origin", "status", "last_verified",
              "refuted", "superseded_by")


def tip_files(root, slug):
    """Tip ids of one tips directory (a project slug or `_global`)."""
    d = os.path.join(root, TIPS, slug)
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    return [n[:-3] for n in names if n.endswith(".md") and TASK_RE.fullmatch(n[:-3])
            and os.path.isfile(os.path.join(d, n))]


def collect_tips(root):
    tips = []
    for slug in subdirs(os.path.join(root, TIPS)):
        for tid in tip_files(root, slug):
            path = os.path.join(root, TIPS, slug, tid + ".md")
            lines = read_lines(os.path.dirname(path), tid + ".md")
            if lines is None:
                continue
            fields, start = parse_frontmatter(lines)
            tip = {k: fields.get(k, "") for k in TIP_FIELDS}
            tip.update({"slug": slug, "id": tid, "level": "global" if slug == GLOBAL else "project",
                        "title": tip["title"] or tid, "status": tip["status"] or "active",
                        "body": "\n".join(lines[start:]).strip("\n"), "file": path,
                        "modified": datetime.datetime.fromtimestamp(os.path.getmtime(path)).astimezone().isoformat()})
            tips.append(tip)
    stats = tip_stats(root, {(t["slug"], t["id"]) for t in tips})
    for t in tips:
        t["stats"] = stats.get((t["slug"], t["id"]), {})
    return tips


OFFERED = {"hook", "prompt-hook", "search"}  # the tip was listed to the agent
STAT_KEYS = {"show": "opened", "verified": "verified", "refuted": "refuted"}


def tip_stats(root, known):
    """Counts log events per tip: offered, opened, verified, refuted, last (ts)."""
    stats = {}
    # The root's log.jsonl is where 1.5.0 and older kept it.
    paths = [os.path.join(root, TIPS, n) for n in ("log.1.jsonl", "log.jsonl")]
    paths += [os.path.join(state_dir(), n) for n in ("tips.1.jsonl", "tips.jsonl")]
    for path in paths:
        try:
            with open(path, encoding="utf-8") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for line in lines:
            try:
                ev = json.loads(line)
                kind, slug, ts = ev["event"], ev.get("project", ""), ev.get("ts", "")
                ids = [i for i in str(ev.get("id") or "").split(",") if i]
            except (ValueError, KeyError, TypeError, AttributeError):
                continue
            key = "offered" if kind in OFFERED else STAT_KEYS.get(kind)
            if not key:
                continue
            for tid in ids:
                # The event's project is the session's; the tip may be global.
                tip = (slug, tid) if (slug, tid) in known else (GLOBAL, tid)
                if tip not in known:
                    continue
                s = stats.setdefault(tip, {})
                s[key] = s.get(key, 0) + 1
                s["last"] = max(s.get("last", ""), ts)
    return stats


def delete_tip(root, slug, tid):
    """Delete one tip file, logged like tips.sh does. Returns an error message or None."""
    if slug not in subdirs(os.path.join(root, TIPS)) or tid not in tip_files(root, slug):
        return "no such tip"
    try:
        os.remove(os.path.join(root, TIPS, slug, tid + ".md"))
    except OSError as e:
        return str(e)
    event = {"ts": datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z"),
             "event": "deleted", "project": slug, "id": tid, "hits": 0, "via": "dashboard"}
    try:
        os.makedirs(state_dir(), exist_ok=True)
        with open(os.path.join(state_dir(), "tips.jsonl"), "a", encoding="utf-8") as fh:
            fh.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass
    return None


# --- auth ---------------------------------------------------------------------
# `auth = on` in the config file: a password login (hash in PASSWORD next to
# the config file), sessions in $HANDOFF_STATE/sessions (only SHA-256 of the
# IDs), a per-session CSRF token. `auth = off`: loopback only, no login.

PASSWORD = "password"
SESSIONS = "sessions"
PW_MIN, PW_MAX = 6, 1024
SCRYPT = (17, 8, 1)  # log2 N, r, p: 128 MiB, ~0.5 s on a phone
PBKDF2_ITERS = 600000  # when hashlib has no scrypt (Python built without OpenSSL 1.1)
LOCK_AFTER, LOCK_FIRST, LOCK_MAX = 5, 30, 900  # failures, then 30 s doubling to 15 min
DURATION = re.compile(r"^(\d+)\s*([smhd]?)$")


def password_path():
    return os.path.join(os.path.dirname(config_path()), PASSWORD)


def b64(b):
    return base64.urlsafe_b64encode(b).decode().rstrip("=")


def unb64(s):
    return base64.urlsafe_b64decode(s + "=" * (-len(s) % 4))


def scrypt_maxmem(n, r):
    return 2 * 128 * r * (1 << n) + (1 << 20)  # OpenSSL needs a bit more than 128*r*N


def hash_password(pw):
    salt, data = secrets.token_bytes(16), pw.encode("utf-8")
    n, r, p = SCRYPT
    try:
        h = hashlib.scrypt(data, salt=salt, n=1 << n, r=r, p=p, maxmem=scrypt_maxmem(n, r), dklen=32)
        return "scrypt$%d$%d$%d$%s$%s" % (n, r, p, b64(salt), b64(h))
    except (AttributeError, ValueError, MemoryError):
        h = hashlib.pbkdf2_hmac("sha256", data, salt, PBKDF2_ITERS)
        return "pbkdf2_sha256$%d$%s$%s" % (PBKDF2_ITERS, b64(salt), b64(h))


def check_password(pw, stored):
    """True if pw matches a hash from hash_password; a bad hash is False."""
    data = pw.encode("utf-8")
    try:
        kind, *f = stored.split("$")
        if kind == "scrypt":
            n, r, p, salt, want = int(f[0]), int(f[1]), int(f[2]), unb64(f[3]), unb64(f[4])
            got = hashlib.scrypt(data, salt=salt, n=1 << n, r=r, p=p, maxmem=scrypt_maxmem(n, r), dklen=len(want))
        elif kind == "pbkdf2_sha256":
            salt, want = unb64(f[1]), unb64(f[2])
            got = hashlib.pbkdf2_hmac("sha256", data, salt, int(f[0]), len(want))
        else:
            return False
    except (ValueError, IndexError, AttributeError, MemoryError):
        return False
    return hmac.compare_digest(got, want)


def read_password():
    """The stored hash, or ""."""
    try:
        with open(password_path(), encoding="utf-8") as fh:
            return fh.read().strip()
    except OSError:
        return ""


def write_private(path, text):
    """Atomically writes a 0600 file."""
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = "%s.%d.tmp" % (path, os.getpid())
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


def duration(value, default):
    m = DURATION.match((value or "").strip().lower())
    if not m:
        return default
    return int(m.group(1)) * {"": 1, "s": 1, "m": 60, "h": 3600, "d": 86400}[m.group(2)]


def auth_config():
    """(auth, public_url, idle, max) from the config file; auth is "on",
    "off" or the bad value, public_url is "" or its origin."""
    v = config_values()
    auth = (v.get("auth") or "off").lower()
    public = v.get("public_url", "").rstrip("/")
    return auth, public, duration(v.get("auth.idle"), 7 * 86400), duration(v.get("auth.max"), 30 * 86400)


def public_origin(url):
    """scheme://host[:port] of public_url, lowercased; None if it is not one."""
    u = urllib.parse.urlsplit(url)
    if u.scheme not in ("http", "https") or not u.hostname or u.path not in ("", "/") or u.query or u.username:
        return None
    return "%s://%s" % (u.scheme, u.netloc.lower())


def pw_tag(stored):
    """Sessions belong to one password: a new password logs everyone out."""
    return hashlib.sha256(stored.encode("utf-8")).hexdigest()[:16]


class Sessions:
    """Sessions on disk (so a restart keeps them): `sha256(id) created last
    tag` lines. Read on every check, so `handoffs auth logout-all` works on a
    running dashboard."""

    lock = threading.Lock()
    TOUCH = 60  # seconds between writes of the last-seen time

    def __init__(self, idle, max_age):
        self.idle, self.max_age = idle, max_age

    @staticmethod
    def path():
        return os.path.join(state_dir(), SESSIONS)

    def _read(self, now, tag):
        live = {}
        try:
            with open(self.path(), encoding="utf-8") as fh:
                for line in fh:
                    f = line.split()
                    try:
                        key, created, last, t = f[0], int(f[1]), int(f[2]), f[3]
                    except (IndexError, ValueError):
                        continue
                    if t == tag and now - last < self.idle and now - created < self.max_age:
                        live[key] = [created, last, t]
        except OSError:
            pass
        return live

    def _write(self, live):
        write_private(self.path(), "".join("%s %d %d %s\n" % (k, c, lst, t) for k, (c, lst, t) in live.items()))

    @staticmethod
    def key(sid):
        return hashlib.sha256(sid.encode("utf-8")).hexdigest()

    def create(self, tag):
        sid = secrets.token_urlsafe(32)
        now = int(time.time())
        with self.lock:
            live = self._read(now, tag)
            live[self.key(sid)] = [now, now, tag]
            self._write(live)
        return sid

    def valid(self, sid, tag):
        if not sid or not tag:
            return False
        now = int(time.time())
        with self.lock:
            live = self._read(now, tag)
            s = live.get(self.key(sid))
            if not s:
                return False
            if now - s[1] >= self.TOUCH:
                s[1] = now
                self._write(live)
        return True

    def drop(self, sid, tag):
        with self.lock:
            live = self._read(int(time.time()), tag)
            if live.pop(self.key(sid), None):
                self._write(live)

    def count(self, tag):
        return len(self._read(int(time.time()), tag))


def csrf_token(sid):
    return hmac.new(sid.encode("utf-8"), b"handoffs-csrf", hashlib.sha256).hexdigest()[:32]


class Throttle:
    """One failure counter for the whole dashboard: behind a proxy every
    client is 127.0.0.1. After LOCK_AFTER failures logins are refused for
    LOCK_FIRST seconds, doubling with each failure after that, up to LOCK_MAX."""

    def __init__(self):
        self.lock = threading.Lock()  # also runs the password checks one at a time (128 MiB each)
        self.fails, self.until = 0, 0.0

    def wait(self):
        """Seconds until a login may be tried, or 0."""
        return max(0, int(self.until - time.time() + 0.999))

    def failed(self):
        self.fails += 1
        if self.fails >= LOCK_AFTER:
            self.until = time.time() + min(LOCK_MAX, LOCK_FIRST * 2 ** (self.fails - LOCK_AFTER))

    def ok(self):
        self.fails, self.until = 0, 0.0


def set_config(key, value):
    """Sets `key = value` in the config file, keeping everything else."""
    path = config_path()
    try:
        with open(path, encoding="utf-8") as fh:
            lines = fh.read().splitlines()
    except OSError:
        lines = []
    out, done = [], False
    for line in lines:
        if line.partition("=")[1] and line.partition("=")[0].strip() == key:
            if not done:
                out.append("%s = %s" % (key, value))
                done = True
            continue
        out.append(line)
    if not done:
        out.append("%s = %s" % (key, value))
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w", encoding="utf-8") as fh:
        fh.write("\n".join(out) + "\n")


def new_password(args):
    """The password from --generate, --stdin or the terminal; exits on errors."""
    if args.generate:
        pw = secrets.token_urlsafe(18)
        print("password: " + pw)
        print("(shown once; keep it in a password manager)")
        return pw
    if args.stdin or not sys.stdin.isatty():
        pw = sys.stdin.readline().rstrip("\r\n")
    else:
        pw = getpass.getpass("New dashboard password: ")
        if pw != getpass.getpass("Repeat it: "):
            raise SystemExit("error: the passwords differ")
    if not PW_MIN <= len(pw) <= PW_MAX:
        raise SystemExit("error: the password must be %d to %d characters (or use --generate)" % (PW_MIN, PW_MAX))
    return pw


def restart_service():
    """Restarts an installed `handoffs service`, so a config change applies."""
    kind = os.environ.get("HANDOFF_SERVICE_KIND") or service_kind()
    if kind in ("systemd", "launchd") and os.path.exists(service_path(kind)):
        if service_main(["restart"]) == 0:
            print("restarted the handoffs service")
    elif read_pidfile(os.path.join(state_dir(), PIDFILE))[0]:
        print("note: restart the background dashboard to apply: handoffs --stop; handoffs --background")


def auth_main(argv):
    ap = argparse.ArgumentParser(prog="handoffs auth", description="Password login for the dashboard.")
    ap.add_argument("action", choices=["status", "on", "off", "password", "logout-all"])
    g = ap.add_mutually_exclusive_group()
    g.add_argument("--generate", action="store_true", help="password: make a random one and print it")
    g.add_argument("--stdin", action="store_true", help="password: read it from the first line of stdin")
    args = ap.parse_args(argv)
    auth, public, idle, max_age = auth_config()
    stored = read_password()
    if args.action == "status":
        print("auth: %s" % auth)
        print("password: %s" % ("set (%s)" % stored.split("$", 1)[0] if stored else "not set"))
        print("public_url: %s" % (public or "-"))
        print("sessions: %d (idle %ds, max %ds)" % (Sessions(idle, max_age).count(pw_tag(stored)) if stored else 0,
                                                   idle, max_age))
        return 0
    if args.action == "password" or (args.action == "on" and not stored):
        if args.action == "on" and not (args.generate or args.stdin or sys.stdin.isatty()):
            print("error: no password yet: handoffs auth password [--generate|--stdin]", file=sys.stderr)
            return 2
        write_private(password_path(), hash_password(new_password(args)) + "\n")
        write_private(Sessions.path(), "")
        print("wrote %s (all sessions signed out)" % password_path())
    if args.action == "logout-all":
        write_private(Sessions.path(), "")
        print("signed out all sessions")
    if args.action in ("on", "off"):
        set_config("auth", args.action)
        print("auth = %s in %s" % (args.action, config_path()))
        if args.action == "off" and public:
            print("warning: public_url is set, so the dashboard will not start without auth", file=sys.stderr)
        restart_service()
    return 0


def auth_error(host):
    """Why the dashboard must not start on host with this config, or ""."""
    auth, public, _, _ = auth_config()
    if auth not in ("on", "off"):
        return "auth in %s must be on or off, got %r" % (config_path(), auth)
    if public and not public_origin(public):
        return "public_url in %s must be http(s)://host[:port], got %r" % (config_path(), public)
    if auth == "on" and not read_password():
        return "auth = on, but no password is set (handoffs auth password)"
    if auth == "off" and (host not in LOOPBACK or public):
        return "the dashboard on %s needs auth = on (handoffs auth on)" % (public or host)
    return ""


# --- server -------------------------------------------------------------------

CSP = ("default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
       "connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'")
LOGIN_CSP = "default-src 'none'; style-src 'unsafe-inline'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
LOGIN_FAILED = "Wrong password, or too many attempts: wait a bit and try again."


class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "handoffs/" + VERSION
    allowed_hosts = LOOPBACK
    any_ip = False  # listening on 0.0.0.0/::: any IP address is a valid Host
    token = ""  # auth off: the page's CSRF token
    sessions = None  # auth on: Sessions
    throttle = None  # auth on: Throttle
    public = ""  # public_url's origin: a valid Host and Origin (behind a proxy)

    def host(self):
        return (self.headers.get("Host") or "").strip().lower()

    def host_ok(self):
        host = self.host()
        if host.startswith("["):
            host = host[1:].split("]", 1)[0]
        elif host.count(":") == 1:
            host = host.split(":", 1)[0]
        if host in self.allowed_hosts:
            return True
        if self.any_ip:
            try:
                ipaddress.ip_address(host)
                return True
            except ValueError:
                return False
        return False

    def origin_ok(self):
        origin = (self.headers.get("Origin") or "").lower()
        return not origin or origin in ("http://" + self.host(), self.public)

    def send(self, code, ctype, body, headers=(), csp=CSP, referrer="no-referrer"):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", referrer)
        self.send_header("Content-Security-Policy", csp)
        for k, v in headers:
            self.send_header(k, v)
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, obj, code=200, headers=()):
        return self.send(code, "application/json; charset=utf-8", json.dumps(obj, ensure_ascii=False), headers)

    def not_found(self):
        return self.send(404, "text/plain; charset=utf-8", "not found\n")

    def redirect(self, where, headers=()):
        return self.send(303, "text/plain; charset=utf-8", "", [("Location", where)] + list(headers))

    # Behind an HTTPS proxy (public_url): __Host- cookie, Secure. Plain HTTP
    # (loopback, a LAN address): a plain cookie, which the browser would drop if Secure.
    def secure(self):
        return self.public.startswith("https://") and self.public == "https://" + self.host()

    def cookie_name(self):
        return "__Host-handoffs" if self.secure() else "handoffs"

    def cookie(self, value, max_age):
        return ("Set-Cookie", "%s=%s; Max-Age=%d; Path=/; HttpOnly; SameSite=Strict%s"
                % (self.cookie_name(), value, max_age, "; Secure" if self.secure() else ""))

    def session(self):
        """The valid session ID from the cookie, or ""."""
        name = self.cookie_name()
        for part in (self.headers.get("Cookie") or "").split(";"):
            k, _, v = part.strip().partition("=")
            if k == name and v:
                stored = read_password()
                return v if stored and self.sessions.valid(v, pw_tag(stored)) else ""
        return ""

    def client(self):
        """The client's IP for the log: behind a local proxy, the last X-Forwarded-For hop."""
        peer = self.client_address[0]
        fwd = (self.headers.get("X-Forwarded-For") or "").split(",")[-1].strip()
        return fwd if fwd and peer in LOOPBACK | {"::ffff:127.0.0.1"} else peer

    def login_page(self, code=200, msg="", headers=()):
        page = LOGIN_PAGE.replace("__MSG__", '<p class="err" role="alert">%s</p>' % msg if msg else "")
        # With no-referrer the browser posts the form with `Origin: null`.
        return self.send(code, "text/html; charset=utf-8", page, headers, csp=LOGIN_CSP, referrer="same-origin")

    def login(self):
        try:
            n = int(self.headers.get("Content-Length") or 0)
            form = urllib.parse.parse_qs(self.rfile.read(min(n, 8192)).decode("utf-8", "replace"))
        except ValueError:
            form = {}
        pw = (form.get("password") or [""])[0]
        wait = self.throttle.wait()
        if not wait:
            with self.throttle.lock:
                wait = self.throttle.wait()  # another login may have failed meanwhile
                if not wait:
                    stored = read_password()
                    if stored and len(pw) <= PW_MAX and check_password(pw, stored):
                        self.throttle.ok()
                        sid = self.sessions.create(pw_tag(stored))
                        return self.redirect("./", [self.cookie(sid, self.sessions.max_age)])
                    self.throttle.failed()
                    print("%s handoffs: failed login from %s" % (
                        datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z"), self.client()),
                        file=sys.stderr, flush=True)
                    return self.login_page(401, LOGIN_FAILED)
        return self.login_page(429, LOGIN_FAILED, [("Retry-After", str(wait))])

    def do_GET(self):  # noqa: N802 (http.server API)
        if not self.host_ok():
            return self.send(403, "text/plain; charset=utf-8", "forbidden host\n")
        path, _, query = self.path.partition("?")
        token = self.token
        if self.sessions:
            sid = self.session()
            if path == "/login":
                return self.redirect("./") if sid else self.login_page()
            if not sid:
                if path.startswith("/api/"):
                    return self.send_json({"error": "login required"}, 401)
                return self.redirect("login")
            token = csrf_token(sid)
        elif path == "/login":
            return self.redirect("./")
        q = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
        key = (handoff_root(), q.get("slug", ""), q.get("status", ""), q.get("task", ""))
        if path in ("/", "/index.html"):
            return self.send(200, "text/html; charset=utf-8", PAGE.replace("__TOKEN__", token))
        if path == "/api/tasks":
            data = collect(handoff_root())
            data["auth"] = bool(self.sessions)
            return self.send_json(data)
        if path == "/api/search":
            return self.send_json(search(handoff_root(), q.get("q", "")[:200]))
        result = None
        if path == "/api/handoff":
            result = read_body(*key, name=q.get("file", ""))
        elif path == "/api/history":
            result = history(*key)
        elif path == "/api/diff":
            result = diff(*key, q.get("old", ""), q.get("new", ""))
        return self.not_found() if result is None else self.send_json(result)

    def do_POST(self):  # noqa: N802 (http.server API)
        if not self.host_ok():
            return self.send(403, "text/plain; charset=utf-8", "forbidden host\n")
        path = self.path.split("?", 1)[0]
        if not self.origin_ok():
            return self.send_json({"error": "forbidden"}, 403)
        token = self.token
        if self.sessions:
            if path == "/login":
                return self.login()
            sid = self.session()
            if not sid:
                return self.send_json({"error": "login required"}, 401)
            token = csrf_token(sid)
        if not token or not hmac.compare_digest(self.headers.get("X-Handoffs-Token") or "", token):
            return self.send_json({"error": "forbidden"}, 403)
        if path == "/api/logout" and self.sessions:
            stored = read_password()
            self.sessions.drop(sid, pw_tag(stored))
            return self.send_json({"ok": True}, headers=[self.cookie("", 0)])
        if path not in ("/api/done", "/api/restore", "/api/rename", "/api/tip/delete"):
            return self.not_found()
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 4096)) or b"{}")
            slug = str(body["slug"])
            if path == "/api/tip/delete":
                tid = str(body["id"])
            else:
                task = str(body["task"])
            if path == "/api/rename":
                status, new = str(body["status"]), str(body["new"])
        except (ValueError, KeyError, TypeError):
            return self.send_json({"error": "bad request"}, 400)
        if path == "/api/tip/delete":
            err = delete_tip(handoff_root(), slug, tid)
        elif path == "/api/rename":
            err = rename_task(handoff_root(), slug, status, task, new)
        else:
            err = move_task(handoff_root(), slug, task, archive=path == "/api/done")
        return self.send_json({"error": err}, 409) if err else self.send_json({"ok": True})

    def log_message(self, *args):
        pass


def make_server(host, port):
    family = socket.AF_INET6 if ":" in host else socket.AF_INET

    class Server(http.server.ThreadingHTTPServer):
        address_family = family
        allow_reuse_address = os.name != "nt"  # on Windows it lets two servers share a port
        daemon_threads = True

        def server_bind(self):
            # HTTPServer.server_bind calls socket.getfqdn(), which can take
            # seconds (reverse DNS on macOS); the name is never used here.
            socketserver.TCPServer.server_bind(self)
            self.server_name, self.server_port = self.server_address[:2]

    last = None
    for p in range(port, port + PORT_TRIES) if port else [0]:
        try:
            return Server((host, p), Handler)
        except OSError as e:
            last = e
    raise SystemExit("error: cannot listen on %s:%s-%s (%s)" % (host, port, port + PORT_TRIES - 1, last))


# --- browser ------------------------------------------------------------------

def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def open_browser(url):
    """Best effort; returns False when the URL should just be opened by hand."""
    env = os.environ
    if env.get("SSH_CONNECTION") or env.get("SSH_TTY"):
        return False
    if env.get("TERMUX_VERSION") or "com.termux" in env.get("PREFIX", ""):
        return bool(shutil.which("termux-open-url")) and spawn(["termux-open-url", url])
    if sys.platform.startswith("linux"):
        if env.get("WSL_DISTRO_NAME") or "microsoft" in platform.release().lower():
            if shutil.which("wslview"):
                return spawn(["wslview", url])
            return bool(shutil.which("explorer.exe")) and spawn(["explorer.exe", url])
        if not (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")):
            return False  # no GUI: webbrowser could start a text browser in this terminal
    try:
        return webbrowser.open(url)
    except Exception:  # noqa: BLE001 (any browser failure means "open by hand")
        return False


# --- background & service -----------------------------------------------------

PIDFILE = "handoffs.pid"  # "<pid> <url>" of a --background dashboard
LABEL = "com.claude-handoff.handoffs"


def drop_legacy():
    """Removes the PID file and log 1.5.0 and older kept in the root. The PID
    is not trusted: in a root shared by machines it may be another machine's."""
    for name in (".handoffs.pid", ".handoffs.log"):
        try:
            os.remove(os.path.join(handoff_root(), name))
        except OSError:
            pass


def pid_alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def read_pidfile(path):
    try:
        with open(path, encoding="utf-8") as fh:
            pid, _, url = fh.read().strip().partition(" ")
        pid = int(pid)
    except (OSError, ValueError):
        return None, ""
    return (pid, url) if pid_alive(pid) else (None, "")


def start_background(argv, no_open):
    """Re-run the dashboard detached, wait for its URL line, record the PID."""
    state = state_dir()
    os.makedirs(state, exist_ok=True)
    pidfile = os.path.join(state, PIDFILE)
    drop_legacy()
    pid, url = read_pidfile(pidfile)
    if pid:
        print("handoffs: already running at %s (pid %d; handoffs --stop)" % (url, pid))
        return 0
    log = os.path.join(state, "handoffs.log")
    args = [a for a in argv if a != "--background"] + ["--no-open"]
    with open(log, "w", encoding="utf-8") as out:
        proc = subprocess.Popen([sys.executable, os.path.abspath(__file__)] + args,
                                stdin=subprocess.DEVNULL, stdout=out, stderr=subprocess.STDOUT,
                                start_new_session=True)
    url = ""
    for _ in range(300):  # up to 15 s
        try:
            with open(log, encoding="utf-8") as fh:
                m = re.search(r"^handoffs: (\S+)", fh.read(), re.M)
        except OSError:
            m = None
        if m:
            url = m.group(1)
            break
        if proc.poll() is not None:
            break
        time.sleep(0.05)
    if not url:
        with open(log, encoding="utf-8") as fh:
            sys.stderr.write(fh.read())
        if proc.poll() is None:
            proc.terminate()
        print("error: the dashboard did not start (log: %s)" % log, file=sys.stderr)
        return 1
    with open(pidfile, "w", encoding="utf-8") as fh:
        fh.write("%d %s\n" % (proc.pid, url))
    print("handoffs: %s  (pid %d; handoffs --stop to stop)" % (url, proc.pid))
    if not no_open and not open_browser(url):
        print("open the URL above in a browser")
    return 0


def stop_background():
    drop_legacy()
    pidfile = os.path.join(state_dir(), PIDFILE)
    pid, _ = read_pidfile(pidfile)
    if os.path.exists(pidfile):
        os.remove(pidfile)
    if not pid:
        print("handoffs: no background dashboard is running")
        return 1
    os.kill(pid, signal.SIGTERM)
    print("handoffs: stopped (pid %d)" % pid)
    return 0


def service_kind():
    if sys.platform == "darwin":
        return "launchd"
    if sys.platform.startswith("linux") and shutil.which("systemctl") and not os.environ.get("TERMUX_VERSION"):
        return "systemd"
    return ""


def service_path(kind):
    home = os.path.expanduser("~")
    if kind == "launchd":
        return os.path.join(home, "Library", "LaunchAgents", LABEL + ".plist")
    cfg = os.environ.get("XDG_CONFIG_HOME") or os.path.join(home, ".config")
    return os.path.join(cfg, "systemd", "user", "handoffs.service")


def service_env():
    # Not HANDOFF_ROOT: the service reads root= from the config file on every
    # start, so changing it needs only `handoffs service restart`.
    return {k: os.environ[k] for k in ("HANDOFF_CONFIG", "XDG_CONFIG_HOME", "XDG_DATA_HOME", "HANDOFF_STATE", "XDG_STATE_HOME", "HANDOFF_PORT") if os.environ.get(k)}


def systemd_quote(s):
    if s and not re.search(r'[\s"\\\'$%;]', s):
        return s
    return '"%s"' % s.replace("\\", "\\\\").replace('"', '\\"').replace("$", "$$").replace("%", "%%")


def service_file(kind, cmd, env):
    if kind == "systemd":
        lines = ["[Unit]", "Description=claude-handoff dashboard (handoffs)", "", "[Service]",
                 "ExecStart=" + " ".join(systemd_quote(c) for c in cmd)]
        lines += ["Environment=" + systemd_quote("%s=%s" % kv) for kv in sorted(env.items())]
        lines += ["Restart=on-failure", "", "[Install]", "WantedBy=default.target", ""]
        return "\n".join(lines)
    from xml.sax.saxutils import escape
    s = lambda v: "<string>%s</string>" % escape(v)  # noqa: E731
    logf = os.path.join(os.path.expanduser("~"), "Library", "Logs", "handoffs.log")
    out = ['<?xml version="1.0" encoding="UTF-8"?>',
           '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">',
           '<plist version="1.0">', "<dict>",
           "<key>Label</key>" + s(LABEL),
           "<key>ProgramArguments</key>", "<array>"] + ["  " + s(c) for c in cmd] + ["</array>"]
    if env:
        out += ["<key>EnvironmentVariables</key>", "<dict>"]
        out += ["  <key>%s</key>%s" % (escape(k), s(v)) for k, v in sorted(env.items())]
        out += ["</dict>"]
    out += ["<key>RunAtLoad</key><true/>", "<key>KeepAlive</key><true/>",
            "<key>StandardOutPath</key>" + s(logf), "<key>StandardErrorPath</key>" + s(logf),
            "</dict>", "</plist>", ""]
    return "\n".join(out)


def run(cmd, quiet=False):
    r = subprocess.run(cmd, stdout=subprocess.DEVNULL if quiet else None,
                       stderr=subprocess.DEVNULL if quiet else None)
    return r.returncode


def service_main(argv):
    ap = argparse.ArgumentParser(prog="handoffs service",
                                 description="Run the dashboard as a user service (systemd --user or launchd).")
    ap.add_argument("action", choices=["install", "uninstall", "restart", "status"])
    ap.add_argument("--port", type=int, help="port for the service (default: $HANDOFF_PORT or 8765)")
    ap.add_argument("--host", help="address to listen on (default: 127.0.0.1)")
    ap.add_argument("--dry-run", action="store_true", help="print the service file and commands; change nothing")
    args = ap.parse_args(argv)
    kind = os.environ.get("HANDOFF_SERVICE_KIND") or service_kind()  # override for tests
    if kind not in ("systemd", "launchd"):
        print("error: no systemd --user or launchd here; use `handoffs --background` instead", file=sys.stderr)
        return 2
    path = service_path(kind)
    uid = "gui/%d" % os.getuid()
    if kind == "systemd":
        cmds = {"install": [["systemctl", "--user", "daemon-reload"],
                            ["systemctl", "--user", "enable", "--now", "handoffs.service"],
                            ["systemctl", "--user", "restart", "handoffs.service"]],
                "uninstall": [["systemctl", "--user", "disable", "--now", "handoffs.service"]],
                "restart": [["systemctl", "--user", "try-restart", "handoffs.service"]],
                "status": [["systemctl", "--user", "--no-pager", "status", "handoffs.service"]]}
    else:
        cmds = {"install": [["launchctl", "bootout", uid, path], ["launchctl", "bootstrap", uid, path]],
                "uninstall": [["launchctl", "bootout", uid, path]],
                "restart": [["launchctl", "kickstart", "-k", "%s/%s" % (uid, LABEL)]],
                "status": [["launchctl", "print", "%s/%s" % (uid, LABEL)]]}
    installed = os.path.exists(path)

    if args.action == "install":
        cmd = [sys.executable, os.path.abspath(__file__), "--no-open"]
        if args.port is not None:
            cmd += ["--port", str(args.port)]
        if args.host:
            cmd += ["--host", args.host]
        err = auth_error((args.host or "127.0.0.1").strip("[]"))
        if err:
            print("error: " + err, file=sys.stderr)
            return 2
        text = service_file(kind, cmd, service_env())
        if args.dry_run:
            print("# %s" % path)
            sys.stdout.write(text)
            for c in cmds["install"]:
                print("$ " + " ".join(c))
            return 0
        os.makedirs(os.path.dirname(path), exist_ok=True)
        with open(path, "w", encoding="utf-8") as fh:
            fh.write(text)
        print("wrote %s" % path)
        if kind == "launchd":
            run(cmds["install"][0], quiet=True)  # not loaded yet is fine
            rc = run(cmds["install"][1])
        else:
            rc = run(cmds["install"][0]) or run(cmds["install"][1]) or run(cmds["install"][2])
        if rc:
            return rc
        print("handoffs service is running: http://127.0.0.1:%s/" % (args.port or os.environ.get("HANDOFF_PORT") or 8765))
        if kind == "systemd":
            print("note: to keep it running while logged out: loginctl enable-linger")
        return 0

    if not installed:
        if args.action == "restart":
            return 0  # nothing to restart (install.sh calls this after an upgrade)
        print("handoffs service is not installed (handoffs service install)")
        return 1 if args.action == "status" else 0
    if args.dry_run:
        for c in cmds[args.action]:
            print("$ " + " ".join(c))
        if args.action == "uninstall":
            print("$ rm " + path)
        return 0
    if args.action == "uninstall":
        run(cmds["uninstall"][0])
        os.remove(path)
        if kind == "systemd":
            run(["systemctl", "--user", "daemon-reload"])
        print("removed %s" % path)
        return 0
    return run(cmds[args.action][0])


# --- main ---------------------------------------------------------------------

def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ["service"]:
        return service_main(argv[1:])
    if argv[:1] == ["paths"]:
        return paths_main(argv[1:])
    if argv[:1] == ["auth"]:
        return auth_main(argv[1:])
    ap = argparse.ArgumentParser(prog="handoffs", description="Local web dashboard for claude-handoff tasks.")
    env_port = os.environ.get("HANDOFF_PORT") or "8765"
    if not env_port.isdigit() or int(env_port) > 65535:
        print("error: HANDOFF_PORT must be a port number (0-65535), got %r" % env_port, file=sys.stderr)
        return 2
    ap.add_argument("--port", type=int, default=int(env_port),
                    help="port to listen on; the next %d are tried if it is busy, 0 picks any "
                         "(default: $HANDOFF_PORT or 8765)" % (PORT_TRIES - 1))
    ap.add_argument("--host", default="127.0.0.1", help="address to listen on (default: 127.0.0.1)")
    ap.add_argument("--no-open", action="store_true", help="do not open a browser")
    ap.add_argument("--background", action="store_true", help="run detached and return (stop: --stop)")
    ap.add_argument("--stop", action="store_true", help="stop the dashboard started with --background")
    ap.add_argument("--json", action="store_true", help="print the task data as JSON and exit")
    ap.add_argument("--version", action="version", version="handoffs " + VERSION)
    args = ap.parse_args(argv)

    if args.json:
        json.dump(collect(handoff_root()), sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0
    if args.stop:
        return stop_background()
    if args.background:
        return start_background(argv, args.no_open)

    host = args.host.strip("[]")
    err = auth_error(host)
    if err:
        print("error: " + err, file=sys.stderr)
        return 2
    auth, public, idle, max_age = auth_config()
    if host not in LOOPBACK:
        Handler.allowed_hosts = LOOPBACK | {host.lower()}
        Handler.any_ip = host in ("0.0.0.0", "::")
        print("warning: listening on %s; other machines may reach the dashboard" % host, file=sys.stderr)
    if public:
        Handler.public = public_origin(public)
        Handler.allowed_hosts = Handler.allowed_hosts | {urllib.parse.urlsplit(public).hostname.lower()}
    if auth == "on":
        Handler.sessions, Handler.throttle = Sessions(idle, max_age), Throttle()
    else:
        Handler.token = secrets.token_urlsafe(24)
    drop_legacy()
    server = make_server(host, args.port)
    port = server.server_address[1]
    shown = "127.0.0.1" if host in ("0.0.0.0", "::") else host
    url = "http://%s:%d/" % ("[%s]" % shown if ":" in shown else shown, port)
    hint = "; Ctrl+C to stop" if sys.stdout.isatty() else ""  # not under a service or --background
    print("handoffs: %s  (root: %s%s)" % (url, handoff_root(), hint), flush=True)
    if not args.no_open and not open_browser(url):
        print("open the URL above in a browser", flush=True)
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(0))  # service/--stop: close the socket cleanly
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        server.server_close()
    return 0


