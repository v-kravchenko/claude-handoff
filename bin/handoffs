#!/usr/bin/env python3
"""Local web dashboard for claude-handoff tasks (part of claude-handoff).

Usage: handoffs [--port N] [--host ADDR] [--no-open] [--json] [--version]

Serves a page with every task of every project under the handoff
root ($HANDOFF_ROOT, else $CLAUDE_CONFIG_DIR/handoffs, else ~/.claude/handoffs).
Data is read from disk on every request. Python 3.8+, standard library only.
"""

import argparse
import datetime
import difflib
import hmac
import http.server
import ipaddress
import json
import os
import platform
import re
import secrets
import shutil
import socket
import subprocess
import sys
import urllib.parse
import webbrowser

VERSION = "1.1.3"
ARCHIVE = "_archive"
TIPS = "_tips"  # tips store (skills/handoff/tips.sh), not a project
GOAL_MAX = 200
NEXT_MAX = 3
PORT_TRIES = 10
LOOPBACK = {"127.0.0.1", "localhost", "::1"}


def handoff_root():
    root = os.environ.get("HANDOFF_ROOT")
    if not root:
        config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
        root = os.path.join(config, "handoffs")
    return root


# --- parsing ------------------------------------------------------------------

def parse_frontmatter(lines):
    """Returns (fields, index of the first body line)."""
    fields = {}
    if not lines or lines[0].strip() != "---":
        return fields, 0
    for i in range(1, len(lines)):
        line = lines[i]
        if line.strip() == "---":
            return fields, i + 1
        key, sep, value = line.partition(": ")
        if sep and key and key not in fields:
            fields[key.strip()] = value.strip()
    return {}, 0  # unterminated: treat the whole file as body


def section(body, name):
    """Lines of the `## name` section (up to the next `#`/`##` heading)."""
    out, inside = [], False
    for line in body:
        if re.match(r"#{1,2}\s", line):
            if inside:
                break
            inside = line.lstrip("#").strip().lower() == name
            continue
        if inside:
            out.append(line)
    return out


def first_paragraph(lines, limit):
    para = []
    for line in lines:
        if line.strip():
            para.append(line.strip())
        elif para:
            break
    text = " ".join(para)
    if len(text) > limit:
        text = text[:limit].rsplit(" ", 1)[0].rstrip(" ,.;:") + "…"
    return text


def list_items(lines):
    """Top-level items of a markdown list; indented lines continue an item."""
    items = []
    for line in lines:
        m = re.match(r"(\d+[.)]|[-*+])\s+(.*)", line)
        if m:
            items.append(m.group(2).strip())
        elif items and line.strip() and line[:1] in " \t":
            items[-1] += " " + line.strip()
    return items


def iso_created(created, filename):
    """ISO 8601 time: from the frontmatter, else from the file name (local time)."""
    for value, fmt in ((created, "%Y-%m-%d %H:%M:%S %z"), (filename[:17], "%Y-%m-%d_%H%M%S")):
        try:
            return datetime.datetime.strptime(value, fmt).isoformat()
        except (TypeError, ValueError):
            pass
    return ""


def own_repo(fields):
    """Git fields describe the project itself: the project directory is the
    repository, or a worktree of it (then `repo` is the main checkout)."""
    project, repo = fields.get("project", ""), fields.get("repo", "")
    if not project or repo in ("", "none"):
        return False
    return repo == project or (fields.get("dir") == project and os.path.exists(os.path.join(project, ".git")))


def read_task(task_dir, task, status):
    files = sorted(f for f in os.listdir(task_dir) if f.endswith(".md"))
    if not files:
        return None
    latest = files[-1]
    try:
        with open(os.path.join(task_dir, latest), encoding="utf-8", errors="replace") as fh:
            lines = fh.read().splitlines()
    except OSError:
        return None
    fields, start = parse_frontmatter(lines)
    body = lines[start:]
    steps = list_items(section(body, "next steps"))
    project = fields.get("project", "")
    none = lambda v: "" if v in (None, "none") else v  # noqa: E731
    return {
        "task": task,
        "status": status,
        "title": fields.get("title") or task,
        "project": project,
        "project_exists": bool(project) and os.path.isdir(project),
        "created": iso_created(fields.get("created"), latest),
        "saved": latest[:-3],
        "versions": len(files),
        "goal": first_paragraph(section(body, "goal"), GOAL_MAX),
        "next": steps[:NEXT_MAX],
        "next_more": max(0, len(steps) - NEXT_MAX),
        "repo": none(fields.get("repo")),
        "branch": none(fields.get("branch")),
        "commit": none(fields.get("commit"))[:7],
        "dir": none(fields.get("dir")),
        "git": own_repo(fields),
    }


def task_dir(root, slug, status, task):
    """Directory of a listed task, or None. Names are matched against directory
    listings, never joined from user input directly."""
    if slug not in projects(root):
        return None
    base = os.path.join(root, slug, ARCHIVE) if status == "archived" else os.path.join(root, slug)
    names = subdirs(base)
    if task not in names or (status != "archived" and task == ARCHIVE):
        return None
    return os.path.join(base, task)


def versions(d):
    try:
        return sorted(f for f in os.listdir(d) if f.endswith(".md")) if d else []
    except OSError:
        return []


def read_lines(d, name):
    try:
        with open(os.path.join(d, name), encoding="utf-8", errors="replace") as fh:
            return fh.read().splitlines()
    except OSError:
        return None


def pick(files, name):
    """`name` if it is one of `files`, the latest file if `name` is empty, else None."""
    if not files:
        return None
    if not name:
        return files[-1]
    return name if name in files else None


def read_body(root, slug, status, task, name=""):
    """Markdown body (without frontmatter) of one handoff of a task (default: the latest)."""
    d = task_dir(root, slug, status, task)
    name = pick(versions(d), name)
    lines = read_lines(d, name) if name else None
    if lines is None:
        return None
    _, start = parse_frontmatter(lines)
    return {"file": name, "body": "\n".join(lines[start:]).strip("\n")}


def history(root, slug, status, task):
    d = task_dir(root, slug, status, task)
    out = []
    for name in reversed(versions(d)):
        fields, _ = parse_frontmatter(read_lines(d, name) or [])
        out.append({"file": name, "title": fields.get("title") or task,
                    "created": iso_created(fields.get("created"), name)})
    return out if d else None


def diff(root, slug, status, task, old, new):
    d = task_dir(root, slug, status, task)
    files = versions(d)
    if not old or not new or pick(files, old) is None or pick(files, new) is None:
        return None
    def body(name):
        lines = read_lines(d, name) or []
        return lines[parse_frontmatter(lines)[1]:]
    lines = difflib.unified_diff(body(old), body(new), old, new, lineterm="", n=2)
    return {"old": old, "new": new, "diff": "\n".join(lines)}


def search(root, query):
    """Tasks whose latest handoff contains `query` (case-insensitive), with a snippet."""
    q = query.strip().lower()
    hits = []
    if len(q) < 2:
        return hits
    for slug in projects(root):
        base = os.path.join(root, slug)
        dirs = [(n, "active", os.path.join(base, n)) for n in subdirs(base) if n != ARCHIVE]
        dirs += [(n, "archived", os.path.join(base, ARCHIVE, n)) for n in subdirs(os.path.join(base, ARCHIVE))]
        for task, status, d in dirs:
            name = pick(versions(d), "")
            text = "\n".join(read_lines(d, name) or []) if name else ""
            i = text.lower().find(q)
            if i >= 0:
                s = max(0, i - 60)
                snippet = " ".join(text[s:i + len(q) + 60].split())
                hits.append({"slug": slug, "status": status, "task": task,
                             "snippet": ("…" if s else "") + snippet + "…"})
    return hits


def move_task(root, slug, task, archive):
    """Archive (`done`) or restore a task, merging into an existing directory,
    like `handoff.sh done|restore`. Returns an error message or None."""
    src = task_dir(root, slug, "active" if archive else "archived", task)
    if not src:
        return "no such task"
    files = versions(src)
    if not files:
        return "no handoffs saved"
    base = os.path.join(root, slug)
    dst = os.path.join(base, ARCHIVE, task) if archive else os.path.join(base, task)
    try:
        if not os.path.exists(dst):
            os.makedirs(os.path.dirname(dst), exist_ok=True)
            os.replace(src, dst)
            return None
        for f in files:  # a task with this name exists there: merge the handoffs
            os.replace(os.path.join(src, f), os.path.join(dst, f))
    except OSError as e:
        return str(e)
    shutil.rmtree(src, ignore_errors=True)  # leftovers such as .DS_Store
    return None


TASK_RE = re.compile(r"[a-z0-9][a-z0-9._-]*")


def rename_task(root, slug, status, task, new):
    """Rename a task (active or archived) in place and update the `task:` field
    of its handoffs. Refuses names taken by an active or archived task.
    Returns an error message or None."""
    src = task_dir(root, slug, status, task)
    if not src:
        return "no such task"
    if not TASK_RE.fullmatch(new) or new == ARCHIVE:
        return "invalid name (use lowercase a-z0-9._-)"
    if new == task:
        return None
    base = os.path.join(root, slug)
    if any(os.path.exists(os.path.join(d, new)) for d in (base, os.path.join(base, ARCHIVE))):
        return "@%s already exists" % new
    dst = os.path.join(os.path.dirname(src), new)
    try:
        os.rename(src, dst)
    except OSError as e:
        return str(e)
    for name in versions(dst):
        set_task_field(os.path.join(dst, name), new)
    return None


def set_task_field(path, new):
    """Rewrite the frontmatter `task:` line of a handoff, keeping everything
    else byte for byte (line endings, mtime). Best effort: the directory name
    is what counts."""
    try:
        with open(path, "rb") as fh:
            lines = fh.read().splitlines(keepends=True)
        if not lines or lines[0].strip() != b"---":
            return
        for i in range(1, len(lines)):
            if lines[i].strip() == b"---":
                return  # no `task:` field
            if lines[i].startswith(b"task: "):
                body = lines[i].rstrip(b"\r\n")
                lines[i] = b"task: " + new.encode() + lines[i][len(body):]
                break
        else:
            return  # unterminated frontmatter
        st = os.stat(path)
        tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
        with open(tmp, "wb") as fh:
            fh.write(b"".join(lines))
        os.utime(tmp, ns=(st.st_atime_ns, st.st_mtime_ns))
        os.replace(tmp, path)
    except OSError:
        pass


def subdirs(path):
    try:
        names = sorted(os.listdir(path))
    except OSError:
        return []
    return [n for n in names if not n.startswith(".") and os.path.isdir(os.path.join(path, n))]


def projects(root):
    return [n for n in subdirs(root) if n != TIPS]


def collect(root):
    tasks = []
    for slug in projects(root):
        base = os.path.join(root, slug)
        for name in subdirs(base):
            if name == ARCHIVE:
                for arch in subdirs(os.path.join(base, ARCHIVE)):
                    tasks.append((slug, read_task(os.path.join(base, ARCHIVE, arch), arch, "archived")))
            else:
                tasks.append((slug, read_task(os.path.join(base, name), name, "active")))
    out = []
    for slug, t in tasks:
        if t:
            t["slug"] = slug
            t["project"] = t["project"] or slug
            out.append(t)
    out.sort(key=lambda t: t["saved"], reverse=True)
    return {"root": root, "home": os.path.expanduser("~"), "version": VERSION, "tasks": out,
            "tips": collect_tips(root)}


# --- tips (files written by skills/handoff/tips.sh) ---------------------------

GLOBAL = "_global"
TIP_FIELDS = ("title", "when", "keywords", "env", "origin", "status", "last_verified",
              "refuted", "superseded_by")


def tip_files(root, slug):
    """Tip ids of one tips directory (a project slug or `_global`)."""
    d = os.path.join(root, TIPS, slug)
    try:
        names = sorted(os.listdir(d))
    except OSError:
        return []
    return [n[:-3] for n in names if n.endswith(".md") and TASK_RE.fullmatch(n[:-3])
            and os.path.isfile(os.path.join(d, n))]


def collect_tips(root):
    tips = []
    for slug in subdirs(os.path.join(root, TIPS)):
        for tid in tip_files(root, slug):
            path = os.path.join(root, TIPS, slug, tid + ".md")
            lines = read_lines(os.path.dirname(path), tid + ".md")
            if lines is None:
                continue
            fields, start = parse_frontmatter(lines)
            tip = {k: fields.get(k, "") for k in TIP_FIELDS}
            tip.update({"slug": slug, "id": tid, "level": "global" if slug == GLOBAL else "project",
                        "title": tip["title"] or tid, "status": tip["status"] or "active",
                        "body": "\n".join(lines[start:]).strip("\n"), "file": path,
                        "modified": datetime.datetime.fromtimestamp(os.path.getmtime(path)).astimezone().isoformat()})
            tips.append(tip)
    return tips


def set_field(path, key, value):
    """Replace `key:` in the frontmatter or add it at its end, like set_field in
    tips.sh; other lines stay byte for byte. Returns an error message or None."""
    value = " ".join(value.split())
    try:
        with open(path, "rb") as fh:
            lines = fh.read().splitlines(keepends=True)
        if not lines or lines[0].strip() != b"---":
            return "no frontmatter"
        eol = lines[0][len(lines[0].rstrip(b"\r\n")):] or b"\n"
        line = key.encode() + b": " + value.encode() + eol
        for i in range(1, len(lines)):
            if lines[i].strip() == b"---":
                lines.insert(i, line)
                break
            if lines[i].startswith(key.encode() + b":"):
                lines[i] = line
                break
        else:
            return "unterminated frontmatter"
        tmp = os.path.join(os.path.dirname(path), "." + os.path.basename(path) + ".tmp")
        with open(tmp, "wb") as fh:
            fh.write(b"".join(lines))
        os.replace(tmp, path)
    except OSError as e:
        return str(e)
    return None


def tip_action(root, slug, tid, action, reason=""):
    """verified | refuted | delete one tip, logged like tips.sh does.
    Returns an error message or None."""
    if slug not in subdirs(os.path.join(root, TIPS)) or tid not in tip_files(root, slug):
        return "no such tip"
    path = os.path.join(root, TIPS, slug, tid + ".md")
    today = datetime.date.today().isoformat()
    if action == "verified":
        err = set_field(path, "status", "active") or set_field(path, "last_verified", today)
    elif action == "refuted":
        err = set_field(path, "status", "refuted") or \
            set_field(path, "refuted", today + " " + (reason.strip() or "no reason given"))
    elif action == "delete":
        try:
            os.remove(path)
            err = None
        except OSError as e:
            err = str(e)
    else:
        return "unknown action"
    if not err:
        event = {"ts": datetime.datetime.now().astimezone().strftime("%Y-%m-%dT%H:%M:%S%z"),
                 "event": "deleted" if action == "delete" else action, "project": slug,
                 "id": tid, "query": "", "hits": 0, "via": "dashboard"}
        try:
            with open(os.path.join(root, TIPS, "log.jsonl"), "a", encoding="utf-8") as fh:
                fh.write(json.dumps(event, ensure_ascii=False) + "\n")
        except OSError:
            pass
    return err


# --- server -------------------------------------------------------------------

class Handler(http.server.BaseHTTPRequestHandler):
    server_version = "handoffs/" + VERSION
    allowed_hosts = LOOPBACK
    any_ip = False  # listening on 0.0.0.0/::: any IP address is a valid Host
    token = ""  # empty: read-only

    def host_ok(self):
        host = (self.headers.get("Host") or "").strip().lower()
        if host.startswith("["):
            host = host[1:].split("]", 1)[0]
        elif host.count(":") == 1:
            host = host.split(":", 1)[0]
        if host in self.allowed_hosts:
            return True
        if self.any_ip:
            try:
                ipaddress.ip_address(host)
                return True
            except ValueError:
                return False
        return False

    def send(self, code, ctype, body):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.send_header("X-Content-Type-Options", "nosniff")
        self.send_header("Referrer-Policy", "no-referrer")
        self.send_header("Content-Security-Policy",
                         "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; "
                         "connect-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; "
                         "frame-ancestors 'none'")
        self.end_headers()
        self.wfile.write(data)

    def send_json(self, obj, code=200):
        return self.send(code, "application/json; charset=utf-8", json.dumps(obj, ensure_ascii=False))

    def not_found(self):
        return self.send(404, "text/plain; charset=utf-8", "not found\n")

    def do_GET(self):  # noqa: N802 (http.server API)
        if not self.host_ok():
            return self.send(403, "text/plain; charset=utf-8", "forbidden host\n")
        path, _, query = self.path.partition("?")
        q = {k: v[0] for k, v in urllib.parse.parse_qs(query).items()}
        key = (handoff_root(), q.get("slug", ""), q.get("status", ""), q.get("task", ""))
        if path in ("/", "/index.html"):
            return self.send(200, "text/html; charset=utf-8", PAGE.replace("__TOKEN__", self.token))
        if path == "/api/tasks":
            data = collect(handoff_root())
            data["writable"] = bool(self.token)
            return self.send_json(data)
        if path == "/api/search":
            return self.send_json(search(handoff_root(), q.get("q", "")[:200]))
        result = None
        if path == "/api/handoff":
            result = read_body(*key, name=q.get("file", ""))
        elif path == "/api/history":
            result = history(*key)
        elif path == "/api/diff":
            result = diff(*key, q.get("old", ""), q.get("new", ""))
        return self.not_found() if result is None else self.send_json(result)

    def do_POST(self):  # noqa: N802 (http.server API)
        if not self.host_ok():
            return self.send(403, "text/plain; charset=utf-8", "forbidden host\n")
        origin = self.headers.get("Origin")
        host = self.headers.get("Host") or ""
        if not self.token or not hmac.compare_digest(self.headers.get("X-Handoffs-Token") or "", self.token) \
                or (origin and origin != "http://" + host):
            return self.send_json({"error": "forbidden"}, 403)
        path = self.path.split("?", 1)[0]
        if path not in ("/api/done", "/api/restore", "/api/rename", "/api/tip"):
            return self.not_found()
        try:
            n = int(self.headers.get("Content-Length") or 0)
            body = json.loads(self.rfile.read(min(n, 4096)) or b"{}")
            slug = str(body["slug"])
            if path == "/api/tip":
                tid, action, reason = str(body["id"]), str(body["action"]), str(body.get("reason") or "")
            else:
                task = str(body["task"])
            if path == "/api/rename":
                status, new = str(body["status"]), str(body["new"])
        except (ValueError, KeyError, TypeError, AttributeError):
            return self.send_json({"error": "bad request"}, 400)
        if path == "/api/tip":
            err = tip_action(handoff_root(), slug, tid, action, reason[:500])
        elif path == "/api/rename":
            err = rename_task(handoff_root(), slug, status, task, new)
        else:
            err = move_task(handoff_root(), slug, task, archive=path == "/api/done")
        return self.send_json({"error": err}, 409) if err else self.send_json({"ok": True})

    def log_message(self, *args):
        pass


def make_server(host, port):
    family = socket.AF_INET6 if ":" in host else socket.AF_INET

    class Server(http.server.ThreadingHTTPServer):
        address_family = family
        allow_reuse_address = os.name != "nt"  # on Windows it lets two servers share a port
        daemon_threads = True

    last = None
    for p in range(port, port + PORT_TRIES) if port else [0]:
        try:
            return Server((host, p), Handler)
        except OSError as e:
            last = e
    raise SystemExit("error: cannot listen on %s:%s-%s (%s)" % (host, port, port + PORT_TRIES - 1, last))


# --- browser ------------------------------------------------------------------

def spawn(cmd):
    try:
        subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        return True
    except OSError:
        return False


def open_browser(url):
    """Best effort; returns False when the URL should just be opened by hand."""
    env = os.environ
    if env.get("SSH_CONNECTION") or env.get("SSH_TTY"):
        return False
    if env.get("TERMUX_VERSION") or "com.termux" in env.get("PREFIX", ""):
        return bool(shutil.which("termux-open-url")) and spawn(["termux-open-url", url])
    if sys.platform.startswith("linux"):
        if env.get("WSL_DISTRO_NAME") or "microsoft" in platform.release().lower():
            if shutil.which("wslview"):
                return spawn(["wslview", url])
            return bool(shutil.which("explorer.exe")) and spawn(["explorer.exe", url])
        if not (env.get("DISPLAY") or env.get("WAYLAND_DISPLAY")):
            return False  # no GUI: webbrowser could start a text browser in this terminal
    try:
        return webbrowser.open(url)
    except Exception:  # noqa: BLE001 (any browser failure means "open by hand")
        return False


# --- main ---------------------------------------------------------------------

def main(argv=None):
    ap = argparse.ArgumentParser(prog="handoffs", description="Local web dashboard for claude-handoff tasks.")
    env_port = os.environ.get("HANDOFF_PORT") or "8765"
    if not env_port.isdigit() or int(env_port) > 65535:
        print("error: HANDOFF_PORT must be a port number (0-65535), got %r" % env_port, file=sys.stderr)
        return 2
    ap.add_argument("--port", type=int, default=int(env_port),
                    help="port to listen on; the next %d are tried if it is busy, 0 picks any "
                         "(default: $HANDOFF_PORT or 8765)" % (PORT_TRIES - 1))
    ap.add_argument("--host", default="127.0.0.1", help="address to listen on (default: 127.0.0.1)")
    ap.add_argument("--no-open", action="store_true", help="do not open a browser")
    ap.add_argument("--read-only", action="store_true", help="disable Done/Restore/Rename and tip buttons")
    ap.add_argument("--json", action="store_true", help="print the task data as JSON and exit")
    ap.add_argument("--version", action="version", version="handoffs " + VERSION)
    args = ap.parse_args(argv)

    if args.json:
        json.dump(collect(handoff_root()), sys.stdout, ensure_ascii=False, indent=2)
        print()
        return 0

    host = args.host.strip("[]")
    if host not in LOOPBACK:
        Handler.allowed_hosts = LOOPBACK | {host.lower()}
        Handler.any_ip = host in ("0.0.0.0", "::")
        print("warning: listening on %s; other machines may reach the dashboard" % host, file=sys.stderr)
    if not args.read_only:
        Handler.token = secrets.token_urlsafe(24)
    server = make_server(host, args.port)
    port = server.server_address[1]
    shown = "127.0.0.1" if host in ("0.0.0.0", "::") else host
    url = "http://%s:%d/" % ("[%s]" % shown if ":" in shown else shown, port)
    print("handoffs: %s  (root: %s; Ctrl+C to stop)" % (url, handoff_root()), flush=True)
    if not args.no_open and not open_browser(url):
        print("open the URL above in a browser", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        server.server_close()
    return 0


