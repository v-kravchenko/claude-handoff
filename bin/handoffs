function icon(name) {
  const NS = "http://www.w3.org/2000/svg";
  const svg = document.createElementNS(NS, "svg");
  svg.setAttribute("viewBox", "0 0 24 24"); svg.setAttribute("aria-hidden", "true");
  ICONS[name].forEach((d) => { const p = document.createElementNS(NS, "path"); p.setAttribute("d", d); svg.appendChild(p); });
  return svg;
}
// A button with an icon and an optional short label (label text lives in .lbl).
function ibtn(name, label, cls) {
  const b = el("button", "ib" + (cls ? " " + cls : ""));
  b.appendChild(icon(name));
  if (label) b.appendChild(el("span", "lbl", label));
  return b;
}

function chip(text, cls, title) {
  const c = el("span", "chip" + (cls ? " " + cls : ""), text);
  if (title) c.title = title;
  return c;
}

const base = (p) => p.replace(/\/+$/, "").split("/").pop();
const DAY = 86400000;

// auth = on: a request without a valid session gets 401; sign in again.
function signedOut(r) {
  if (r.status === 401) { location.href = "login"; throw new Error("signed out"); }
}

async function api(path, params) {
  const r = await fetch("api/" + path + (params ? "?" + new URLSearchParams(params) : ""), { cache: "no-store" });
  signedOut(r);
  if (!r.ok) throw new Error("HTTP " + r.status);
  return r.json();
}

async function post(path, body) {
  const r = await fetch("api/" + path, {
    method: "POST", cache: "no-store",
    headers: { "Content-Type": "application/json", "X-Handoffs-Token": TOKEN },
    body: JSON.stringify(body),
  });
  signedOut(r);
  const res = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(res.error || "HTTP " + r.status);
  return res;
}

const keyOf = (t) => t.slug + "|" + t.status + "|" + t.task;
const ref = (t) => ({ slug: t.slug, status: t.status, task: t.task });

function copyButton(label, text) {
  const btn = ibtn("copy", label, "ghost copy");
  btn.title = "Copy: " + text;
  const code = el("code", "manual", text);
  code.hidden = true;  // shown only when the command has to be copied by hand
  btn.addEventListener("click", (e) => { e.stopPropagation(); copy(text, btn, code, label); });
  return [btn, code];
}

function diffView(text) {
  const pre = el("pre", "diff");
  if (!text) { pre.textContent = "No differences."; return pre; }
  text.split("\n").forEach((l) => {
    const cls = l.startsWith("@@") ? "hunk" : l.startsWith("+") && !l.startsWith("+++") ? "add"
      : l.startsWith("-") && !l.startsWith("---") ? "del" : "";
    pre.appendChild(el("span", cls, l + "\n"));
  });
  return pre;
}

// Details: tabs Latest / History, git context, Rename and Done/Restore.
function details(t, box, actions) {
  const tabs = el("div", "seg tabs");
  tabs.setAttribute("role", "tablist");
  const view = el("div");
  view.setAttribute("role", "tabpanel");
  const tab = (text) => { const b = el("button", "", text); b.setAttribute("role", "tab"); tabs.appendChild(b); return b; };
  const latest = tab("Latest");
  const hist = tab("History");
  if (t.versions > 1) hist.appendChild(el("span", "count", String(t.versions)));
  const bar = el("div", "dbar");
  bar.appendChild(tabs);
  actions.forEach((a) => bar.appendChild(a));
  const crumbs = gitCrumbs(t);
  if (crumbs) box.appendChild(crumbs);
  box.appendChild(bar); box.appendChild(view);
  const fail = (e) => { view.textContent = "Cannot load (" + e.message + ")."; };
  const select = (b) => [latest, hist].forEach((x) => x.setAttribute("aria-selected", String(x === b)));

  async function showFile(file) {
    const h = await api("handoff", Object.assign(ref(t), file ? { file } : {}));
    view.textContent = "";
    view.appendChild(markdown(h.body, t.title));
    view.appendChild(el("div", "file", h.file));
  }
  async function showHistory() {
    const rows = await api("history", ref(t));
    view.textContent = "";
    const list = el("div", "history");
    let current = null;  // the button whose result is open
    rows.forEach((v, i) => {
      const row = el("div", "hrow");
      const when = el("span", "age", age(v.created));
      when.title = v.created;
      row.appendChild(when);
      row.appendChild(rich("span", "htitle", v.title));
      const btns = el("span", "hbtns");
      const panel = el("div", "hpanel");
      panel.hidden = true;
      // toggle(btn, loader): shows the loader's result right under this row.
      const toggle = (btn, loader) => {
        if (current) current.setAttribute("aria-pressed", "false");
        if (current === btn) { current = null; panel.hidden = true; return; }
        list.querySelectorAll(".hpanel").forEach((p) => { p.hidden = true; });
        current = btn;
        btn.setAttribute("aria-pressed", "true");
        panel.hidden = false;
        panel.textContent = "Loading…";
        loader().then((node) => {
          panel.textContent = "";
          panel.appendChild(node);
          panel.scrollIntoView({ block: "nearest" });
        }).catch((e) => { panel.textContent = "Cannot load (" + e.message + ")."; });
      };
      const open = el("button", "", "View");
      open.addEventListener("click", () => toggle(open, async () => {
        const h = await api("handoff", Object.assign(ref(t), { file: v.file }));
        const box = el("div");
        box.appendChild(el("div", "file", h.file));
        box.appendChild(markdown(h.body, null));
        return box;
      }));
      btns.appendChild(open);
      if (i + 1 < rows.length) {
        const d = el("button", "", "Diff");
        d.title = "changes since the previous version";
        d.addEventListener("click", () => toggle(d, async () => {
          const r = await api("diff", Object.assign(ref(t), { old: rows[i + 1].file, new: v.file }));
          const box = el("div");
          box.appendChild(el("div", "file", r.old + " → " + r.new));
          box.appendChild(diffView(r.diff));
          return box;
        }));
        btns.appendChild(d);
      }
      row.appendChild(btns);
      list.appendChild(row);
      list.appendChild(panel);
    });
    view.appendChild(list);
  }

  latest.addEventListener("click", () => { select(latest); showFile("").catch(fail); });
  hist.addEventListener("click", () => { select(hist); view.textContent = "Loading…"; showHistory().catch(fail); });
  select(latest);
  view.textContent = "Loading…";
  return showFile("");
}

// full: the panel lists each fork; a card only counts them. shown: tasks in
// the card's tree, whose links the indentation already shows.
function chips(t, full, shown) {
  const box = el("div", "chips");
  shown = shown || new Set();
  // A done fork under its parent shows a check instead.
  if (t.status === "archived" && !(t.from && shown.has(t.from))) box.appendChild(chip("archived", "archived"));
  forkChips(t, box, full, shown);
  if (!t.project_exists) box.appendChild(chip("path missing", "missing", t.project));
  const idle = Math.floor((Date.now() - Date.parse(t.created)) / DAY);
  if (t.status === "active" && idle >= IDLE_DAYS) box.appendChild(chip("idle " + idle + "d", "warn", "not updated for " + idle + " days"));
  return box;
}

// Fork links within a project: "↑ @parent" and the forks ("↓ @fork" or "↓ n forks").
const statusText = (x) => x ? (x.status === "active" ? "active" : "done") : "missing";
function forkChips(t, box, full, shown) {
  const same = data.tasks.filter((x) => x.slug === t.slug);
  if (t.from && !shown.has(t.from)) {
    const p = same.find((x) => x.task === t.from);
    box.appendChild(taskLink(chip("↑ @" + t.from, p ? "link" : "missing", "fork of @" + t.from + " (" + statusText(p) + ")"), p));
  }
  const kids = same.filter((x) => x.from === t.task && !shown.has(x.task));
  if (full) kids.forEach((k) => box.appendChild(taskLink(chip("↓ @" + k.task, "link", "fork: " + k.title + " (" + statusText(k) + ")"), k)));
  else if (kids.length) {
    box.appendChild(taskLink(chip("↓ " + (kids.length === 1 ? "@" + kids[0].task : kids.length + " forks"), kids.length === 1 ? "link" : "",
      "forks: " + kids.map((k) => "@" + k.task + " (" + statusText(k) + ")").join(", ")), kids.length === 1 ? kids[0] : null));
  }
}
// Makes a chip open task x (a click or Enter), unfolding the archive if needed.
function taskLink(c, x) {
  if (!x) return c;
  c.tabIndex = 0;
  c.setAttribute("role", "button");
  const go = (e) => { e.stopPropagation(); e.preventDefault(); openTask(x); };
  c.addEventListener("click", go);
  c.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") go(e); });
  return c;
}
function openTask(t) {
  if (t.status === "archived" && !state.archOpen.includes(t.project)) { state.archOpen.push(t.project); render(); }
  openPanel("t:" + keyOf(t), hue(projectName(t.project)), projectWho(t.project), (body) => taskPanel(t, body));
}

// Git context as breadcrumb segments: branch > commit (null without git info).
function gitCrumbs(t) {
  const crumbs = el("div", "crumbs mono");
  const seg = (name, text, title) => {
    const c = el("span", "crumb " + name);
    c.appendChild(icon(name));
    c.appendChild(el("span", "", text));
    c.title = title;
    crumbs.appendChild(c);
  };
  // Git info only when the project directory itself is the repository.
  if (t.git && t.branch) seg("branch", t.branch, "branch at handoff time");
  if (t.git && t.commit) seg("commit", t.commit, "commit at handoff time");
  return crumbs.childNodes.length ? crumbs : null;
}

// Card head: title, then "@name · chips"; age and buttons on the right.
function cardHead(title, name, cs, when, whenTitle, buttons, dot) {
  const head = el("div", "head");
  if (dot) {  // the task's state: open, or done (a fork archived under its parent)
    const d = el("span", "nicon " + dot);
    d.title = dot === "done" ? "done (archived)" : "open";
    d.appendChild(icon(dot === "done" ? "cdone" : "copen"));
    head.appendChild(d);
  }
  const main = el("div", "hmain");
  main.appendChild(rich("div", "title", title || name));
  const sl = el("div", "sline");
  if (title && title !== name) sl.appendChild(hl(el("span", "task mono"), name));
  if (cs.childNodes.length) sl.appendChild(cs);
  if (sl.childNodes.length) main.appendChild(sl);
  head.appendChild(main);
  const side = el("div", "side");
  const a = el("span", "age", age(when));
  a.title = whenTitle;
  side.appendChild(a);
  buttons.forEach((b) => side.appendChild(b));
  head.appendChild(side);
  return [head, main];
}

// The "opens in the panel" hint at the end of a row.
function arrow() {
  const a = el("span", "arrow");
  a.appendChild(icon("right"));
  return a;
}

// The side panel: one task or tip at a time; the grid below stays put.
let lastFocus = null;
function markOpen() {
  document.querySelectorAll("#list [data-key]").forEach((e) => e.classList.toggle("open", e.dataset.key === state.open));
}
// "[VB] vst-bank ~/StudioProjects": the project an item belongs to.
function whoNode(avatar, name, sub, title) {
  const w = el("span", "who");
  w.title = title;
  const av = el("span", "avatar sm");
  typeof avatar === "string" ? av.textContent = avatar : av.appendChild(avatar);
  w.appendChild(av);
  w.appendChild(el("span", "pname", name));
  if (sub) w.appendChild(el("span", "ppath", sub));
  return w;
}
// The parent dir of a project, shown next to its name ("~/Projects").
function parentOf(project) {
  const desc = projectDesc(project);
  if (desc) return desc;
  const full = tilde(project), name = base(full) || full;
  return full === "~" ? "home" : full.slice(0, full.length - name.length).replace(/\/$/, "") || "/";
}
const projectWho = (project) => () => whoNode(initials(projectName(project)), projectName(project), parentOf(project), project);
const globalWho = () => whoNode(icon("globe"), "Global tips", "every project on this machine", "");

// where: a function that builds the panel's "which project" line.
function openPanel(key, h, where, build) {
  const p = $("#panel");
  p.style.setProperty("--h", h);
  $("#pwhere").textContent = "";
  $("#pwhere").appendChild(where());
  const body = $("#pbody");
  body.textContent = "";
  body.scrollTop = 0;
  build(body);
  state.open = key;
  markOpen();
  if (p.hidden) lastFocus = document.activeElement;
  p.hidden = false; $("#scrim").hidden = false;
  document.body.classList.add("noscroll");
  $("#pclose").focus();
}
function closePanel() {
  if ($("#panel").hidden) return;
  $("#panel").hidden = true; $("#scrim").hidden = true;
  document.body.classList.remove("noscroll");
  state.open = null;
  markOpen();
  if (lastFocus && document.contains(lastFocus)) lastFocus.focus();
}
// A list row that opens the panel with Enter/Space or a click.
function opener(row, head, open) {
  head.tabIndex = 0;
  head.setAttribute("role", "button");
  head.addEventListener("click", () => { if (!getSelection().toString()) open(); });
  head.addEventListener("keydown", (e) => {
    if (e.target === head && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); open(); }
  });
}
// Panel heading: title, then "@name · chips · age".
function panelHead(body, title, name, cs, when, whenTitle) {
  body.appendChild(rich("h3", "ptitle2", title || name));
  const sl = el("div", "sline");
  if (title && title !== name) sl.appendChild(el("span", "task mono", name));
  if (cs.childNodes.length) sl.appendChild(cs);
  const a = el("span", "age", age(when));
  a.title = whenTitle;
  sl.appendChild(a);
  body.appendChild(sl);
}

// Tasks as a forest of nodes: a task, then its forks (newest subtree first).
// A fork whose parent is not in the list (other section, filtered out) is a root.
function forest(tasks) {
  const names = new Set(tasks.map((t) => t.task)), kids = {}, done = new Set();
  const isRoot = (t) => !t.from || !names.has(t.from) || t.from === t.task;
  tasks.forEach((t) => { if (!isRoot(t)) (kids[t.from] = kids[t.from] || []).push(t); });
  const build = (t) => {
    done.add(t.task);
    const sub = (kids[t.task] || []).filter((k) => !done.has(k.task)).map(build);
    return { t, kids: sub, last: sub.reduce((m, k) => (k.last > m ? k.last : m), t.saved) };
  };
  const order = (list) => { list.sort((a, b) => (b.last > a.last ? 1 : -1)); list.forEach((n) => order(n.kids)); return list; };
  const roots = tasks.filter(isRoot).map(build);
  tasks.forEach((t) => { if (!done.has(t.task)) roots.push(build(t)); });  // cycles: no root leads there
  return order(roots);
}
// marks: dim archived forks with a check (under an active task, not in Archived).
function cards(tasks, marks) {
  const shown = new Set(tasks.map((t) => t.task));
  const node = (n, depth) => {
    const w = el("div", "node" + (depth ? " fork" : "") + (n.kids.length ? " parent" : "") +
      (marks && depth && n.t.status === "archived" ? " done" : ""));
    w.style.setProperty("--depth", depth);
    w.appendChild(card(n.t, marks && depth, shown));
    n.kids.forEach((k) => w.appendChild(node(k, depth + 1)));
    return w;
  };
  return forest(tasks).map((n) => node(n, 0));
}

function card(t, depth, shown) {
  const c = el("div", "item");
  c.dataset.key = "t:" + keyOf(t);
  const [copyBtn, code] = copyButton(LABEL, command(t));
  const [head, main] = cardHead(t.title === t.task ? "" : t.title, "@" + t.task, chips(t, false, shown),
    t.created, t.created, [copyBtn, arrow()], depth && t.status === "archived" ? "done" : "open");
  const snippet = hits.get(keyOf(t));
  if (snippet) main.appendChild(hl(el("div", "snippet"), snippet));
  c.appendChild(head);
  c.appendChild(code);
  opener(c, head, () => openTask(t));
  return c;
}

function taskPanel(t, body) {
  panelHead(body, t.title === t.task ? "" : t.title, "@" + t.task, chips(t, true), t.created, t.created);
  // Copy resume, Rename and Done/Restore sit next to the tabs.
  const [copyBtn, code] = copyButton("Copy resume", command(t));
  copyBtn.classList.replace("ghost", "primary");
  body.appendChild(code);
  const acts = [copyBtn];
  const ren = ibtn("edit", "Rename", "ren");
  ren.title = "rename @" + t.task;
  ren.addEventListener("click", async () => {
    const name = prompt("New name for @" + t.task + " (lowercase a-z0-9._-):", t.task);
    const next = name && name.trim().replace(/^@/, "");
    if (!next || next === t.task) return;
    if (!/^[a-z0-9][a-z0-9._-]*$/.test(next) || next === "_archive") { alert("Invalid name: use lowercase a-z0-9._-"); return; }
    ren.disabled = true;
    try { await post("rename", { slug: t.slug, status: t.status, task: t.task, new: next }); closePanel(); await load(); }
    catch (e) { ren.disabled = false; alert("Failed: " + e.message); }
  });
  acts.push(ren);
  const done = t.status === "active";
  const act = ibtn(done ? "check" : "undo", done ? "Done" : "Restore", "act");
  act.title = done ? "archive the task (like /handoff @" + t.task + " done)" : "move the task back to active";
  act.addEventListener("click", async () => {
    if (!confirm((done ? "Archive" : "Restore") + " @" + t.task + "?")) return;
    act.disabled = true;
    try { await post(done ? "done" : "restore", { slug: t.slug, task: t.task }); closePanel(); await load(); }
    catch (e) { act.disabled = false; alert("Failed: " + e.message); }
  });
  acts.push(act);
  const box = el("div", "details");
  body.appendChild(box);
  details(t, box, acts).catch((e) => { box.textContent = "Cannot load (" + e.message + ")."; });
}

// Tips saved by /handoff (skills/handoff/tips.sh): read and delete; /tips does the rest.
function tipChips(tip) {
  const cs = el("span", "chips");
  if (tip.status !== "active") cs.appendChild(chip(tip.status, "warn", tip.refuted || tip.superseded_by));
  if (tip.env) cs.appendChild(chip("env: " + tip.env));
  if (tip.origin === "web") cs.appendChild(chip("from web", "", "learned from web pages, issues or foreign code"));
  if (tip.last_verified) cs.appendChild(chip("verified " + tip.last_verified));
  const s = tip.stats || {};
  if (s.opened) cs.appendChild(chip("opened " + s.opened + "×", "used", usage(s)));
  else if ((s.offered || 0) >= NEVER_OPENED) cs.appendChild(chip("never opened", "warn",
    usage(s) + "; its keywords may be too broad"));
  else if (s.offered) cs.appendChild(chip("offered " + s.offered + "×", "", usage(s)));
  return cs;
}
// Usage from the tips log: offered = listed by a hook or search, opened = /tips show.
const NEVER_OPENED = 5;
function usage(s) {
  const n = (k, w) => (s[k] || 0) + " " + w;
  return [n("offered", "offered"), n("opened", "opened"), n("verified", "verified"), n("refuted", "refuted")].join(", ") +
    (s.last ? "; last " + s.last.slice(0, 10) : "");
}
function tipCard(tip, where, h) {
  const c = el("div", "item" + (tip.status === "active" ? "" : " dim"));
  c.dataset.key = "p:" + tip.slug + "|" + tip.id;
  const [head] = cardHead(tip.title, tip.id, tipChips(tip), tip.modified, "modified " + tip.modified, [arrow()]);
  c.appendChild(head);
  opener(c, head, () => openPanel(c.dataset.key, h, where, (body) => tipPanel(tip, body)));
  return c;
}
function tipPanel(tip, body) {
  panelHead(body, tip.title, tip.id, tipChips(tip), tip.modified, "modified " + tip.modified);
  const box = el("div", "details");
  // "Tip: / Why: / Verify:" lines are separate paragraphs with bold labels.
  box.appendChild(markdown(tip.body.replace(/\n(?=[A-Z][a-z]+: )/g, "\n\n")
    .replace(/^([A-Z][a-z]+): /gm, "**$1:** "), tip.title));
  const meta = (label, v) => { if (v) box.appendChild(rich("div", "tipmeta", label + ": " + v)); };
  meta("When", tip.when);
  meta("Keywords", tip.keywords);
  meta("Refuted", tip.refuted);
  meta("Usage", tip.stats && tip.stats.last ? usage(tip.stats) : "");
  meta("Superseded by", tip.superseded_by);
  const row = el("div", "actions");
  row.appendChild(el("div", "file", tilde(tip.file)));
  box.appendChild(row);
  const del = ibtn("trash", "Delete");
  del.title = "delete the tip file";
  del.addEventListener("click", async () => {
    if (!confirm("Delete tip " + tip.id + "?")) return;
    del.disabled = true;
    try { await post("tip/delete", { slug: tip.slug, id: tip.id }); closePanel(); await load(); }
    catch (e) { del.disabled = false; alert("Failed: " + e.message); }
  });
  row.appendChild(del);
  body.appendChild(box);
}

// Tips, active first, newest first.
function tipsList(tips, where, h) {
  tips.sort((a, b) => (a.status !== "active") - (b.status !== "active") || b.modified.localeCompare(a.modified));
  return tips.map((t) => tipCard(t, where, h));
}

// A stable hue per project name for its accent colour and avatar.
function hue(name) {
  let h = 0;
  for (const ch of name) h = (h * 31 + ch.codePointAt(0)) % 360;
  return h;
}
function initials(name) {
  const w = name.replace(/^[^\p{L}\p{N}]+/u, "").split(/[^\p{L}\p{N}]+/u).filter(Boolean);
  return ((w.length > 1 ? w[0][0] + w[1][0] : (w[0] || "?").slice(0, 2)) || "?").toUpperCase();
}

function projectName(p) {
  const info = data && data.projects && data.projects[p];
  if (info && info.name) return info.name;
  const t = tilde(p);
  return t === "~" ? "~" : base(t) || t;
}
const projectDesc = (p) => (data && data.projects && data.projects[p] || {}).desc || "";

// The sidebar pick: "all", a project or GLOBAL; kept in the URL hash
// ("#global-tips", "#<project path>", none for All) so a reload keeps it.
const GLOBAL = "_global";
function fromHash() {
  let h = location.hash.slice(1);
  try { h = decodeURI(h); } catch (e) { /* a malformed hash */ }
  return !h ? "all" : h === "global-tips" ? GLOBAL : h;
}
function pick(v) {
  const h = v === "all" ? "" : "#" + (v === GLOBAL ? "global-tips" : encodeURI(v));
  if (h !== location.hash) history.pushState(null, "", h || location.pathname + location.search);
  state.proj = v;
  render();
  window.scrollTo(0, 0);
}
// Sidebar and its <select> twin (narrow screens): All, the projects, Global tips.
// A count is the active tasks, or everything that matches while searching.
function renderNav(rows, nglobal, view, searching) {
  const nav = $("#nav"), sel = $("#navsel");
  nav.textContent = ""; sel.textContent = "";
  const n = (r) => searching ? r.tasks.length + r.ptips.length : r.act.length;
  const add = (v, label, num, lead, title) => {
    const b = el("button", "nitem");
    b.appendChild(lead);
    b.appendChild(el("span", "nname", label));
    b.appendChild(el("span", "count", String(num)));
    if (title) b.title = title;
    if (v === view) b.setAttribute("aria-current", "page");
    b.addEventListener("click", () => pick(v));
    nav.appendChild(b);
    const o = el("option", "", label + " (" + num + ")");
    o.value = v;
    o.selected = v === view;
    sel.appendChild(o);
  };
  add("all", "All", rows.reduce((s, r) => s + n(r), 0), icon("folder"), "every project in one column");
  if (rows.length) nav.appendChild(el("div", "nsep"));
  rows.forEach((r) => {
    const dot = el("span", "dot");
    dot.style.setProperty("--h", hue(projectName(r.project)));
    add(r.project, projectName(r.project), n(r), dot, r.project);
  });
  if (nglobal) {
    nav.appendChild(el("div", "nsep"));
    add(GLOBAL, "Global tips", nglobal, icon("globe"), "tips that hold in every project on this machine");
  }
}

function render() {
  if (!data) return;
  const all = data.tasks;
  // Tips are grouped by slug; a project is found through its tasks' slug.
  const slugOf = {};
  all.forEach((t) => { if (!(t.project in slugOf)) slugOf[t.project] = t.slug; });
  const known = new Set(Object.values(slugOf));
  const tips = data.tips || [];
  const tipOnly = [...new Set(tips.map((t) => t.slug))].filter((s) => s !== "_global" && !known.has(s));
  tipOnly.forEach((s) => { slugOf[s] = s; });
  const projects = [...new Set(all.map((t) => t.project))].concat(tipOnly);  // tasks are newest first

  const q = state.q.trim().toLowerCase();
  const matches = (t) => !q || hits.has(keyOf(t)) ||
    [t.task, t.title, t.goal, t.project].some((f) => f && f.toLowerCase().includes(q));
  const tipMatches = (t) => !q ||
    [t.id, t.title, t.when, t.keywords, t.body].some((f) => f && f.toLowerCase().includes(q));
  const tipsOf = (slug) => tips.filter((t) => t.slug === slug && tipMatches(t));
  $("#ver").textContent = "handoffs " + data.version;
  $("#root").textContent = tilde(data.root);

  const list = $("#list");
  list.textContent = "";
  const count = (n, cls) => el("span", "count" + (cls ? " " + cls : ""), String(n));
  // Section heading: icon avatar, title with a count, subtitle (Global tips).
  const secHead = (name, title, sub, cls) => {
    const head = el("h2", "sechead" + (cls ? " " + cls : ""));
    const av = el("span", "avatar");
    av.appendChild(icon(name));
    head.appendChild(av);
    const pt = el("span", "ptitle");
    const pn = el("span", "pname", title);
    pt.appendChild(pn);
    pt.appendChild(el("span", "ppath", sub));
    head.appendChild(pt);
    return [head, pn];
  };
  const items = (nodes) => { const box = el("div", "items"); nodes.forEach((n) => box.appendChild(n)); return box; };

  // Projects with something to show (a search hides the rest, in the sidebar too).
  const rows = projects.map((project) => {
    const tasks = all.filter((t) => t.project === project && matches(t));
    return { project, tasks, ptips: tipsOf(slugOf[project]), act: tasks.filter((t) => t.status === "active") };
  }).filter((r) => r.tasks.length || r.ptips.length);
  const gtips = tipsOf("_global");
  // The pick falls back to All while it has nothing to show (a search, a stale hash).
  let view = state.proj;
  if (view === GLOBAL ? !gtips.length : view !== "all" && !rows.some((r) => r.project === view)) view = "all";
  renderNav(rows, gtips.length, view, !!q);

  const projectSection = ({ project, tasks, ptips, act }) => {
    // Done forks stay under their active parent (at any depth); the rest go to Archived.
    const tree = act.slice(), inTree = new Set(act.map((t) => t.task));
    for (let grew = true; grew;) {
      grew = false;
      tasks.forEach((t) => {
        if (t.status === "archived" && t.from && inTree.has(t.from) && !inTree.has(t.task)) { tree.push(t); inTree.add(t.task); grew = true; }
      });
    }
    const arch = tasks.filter((t) => t.status === "archived" && !tree.includes(t));
    const name = projectName(project), h = hue(name), parent = parentOf(project);

    const sec = el("section", "project");
    sec.style.setProperty("--h", h);
    const head = el("h2");
    head.title = project;
    head.appendChild(el("span", "avatar", initials(name)));
    const pt = el("span", "ptitle");
    pt.appendChild(hl(el("span", "pname"), name));
    pt.appendChild(el("span", "ppath", parent));
    head.appendChild(pt);
    if (tasks.length && !tasks[0].project_exists) head.appendChild(chip("path missing", "missing"));
    const newest = all.find((t) => t.project === project);  // tasks are newest first
    if (newest) { const a = el("span", "age last", age(newest.created)); a.title = "last handoff " + newest.created; head.appendChild(a); }
    sec.appendChild(head);

    // Tasks | Tips tabs when the project has both.
    const hasTasks = !!newest;
    let tab = state.tab[project] || "tasks";
    if (!ptips.length || !hasTasks) tab = hasTasks ? "tasks" : "tips";
    if (q && tab === "tasks" && !tasks.length) tab = "tips";
    if (q && tab === "tips" && !ptips.length) tab = "tasks";
    if (hasTasks && ptips.length) {
      const tabs = el("div", "seg ptabs");
      tabs.setAttribute("role", "tablist");
      [["tasks", "Tasks", act.length], ["tips", "Tips", ptips.length]].forEach(([k, label, n]) => {
        const b = el("button", "", label);
        b.appendChild(el("span", "count " + k, String(n)));
        b.setAttribute("role", "tab");
        b.setAttribute("aria-selected", String(k === tab));
        b.addEventListener("click", () => { state.tab[project] = k; render(); });
        tabs.appendChild(b);
      });
      sec.appendChild(tabs);
    }
    if (tab === "tips") {
      sec.appendChild(items(tipsList(ptips, projectWho(project), h)));
    } else {
      if (act.length) sec.appendChild(items(cards(tree, true)));
      else sec.appendChild(el("div", "none", "No active tasks."));
      if (arch.length) {
        const open = !!q || state.archOpen.includes(project);
        const tog = ibtn("down", "Archived (" + arch.length + ")", "sub" + (open ? "" : " shut"));
        tog.title = "tasks finished with Done or /handoff @task done";
        tog.addEventListener("click", () => {
          const i = state.archOpen.indexOf(project);
          if (i >= 0) state.archOpen.splice(i, 1); else state.archOpen.push(project);
          render();
        });
        sec.appendChild(tog);
        if (open) sec.appendChild(items(cards(arch)));
      }
    }
    return sec;
  };
  // Global tips: a heading and a grid of cards; folds in All, always open on its own.
  const globalSection = () => {
    const alone = view === GLOBAL;
    const open = alone || state.globalOpen || !!q;  // a search shows matching global tips
    const h = 200;
    const sec = el("section", "globalsec");
    sec.style.setProperty("--h", h);
    const [head, pn] = secHead("globe", "Global tips", "hold in every project on this machine",
      alone ? "" : "gtoggle" + (open ? "" : " shut"));
    pn.appendChild(count(gtips.length, "tips"));
    if (!alone) {
      head.tabIndex = 0;
      head.setAttribute("role", "button");
      head.setAttribute("aria-expanded", String(open));
      const toggle = () => {
        state.globalOpen = !state.globalOpen;
        render();
      };
      head.addEventListener("click", toggle);
      head.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); } });
      const chev = el("span", "chev");
      chev.appendChild(icon("down"));
      head.appendChild(chev);
    }
    sec.appendChild(head);
    if (open) {
      const grid = el("div", "tipgrid");
      tipsList(gtips, globalWho, h).forEach((c) => { c.classList.add("tcard"); grid.appendChild(c); });
      sec.appendChild(grid);
    }
    return sec;
  };

  if (view === GLOBAL) list.appendChild(globalSection());
  else if (view !== "all") list.appendChild(projectSection(rows.find((r) => r.project === view)));
  else {
    rows.forEach((r) => list.appendChild(projectSection(r)));
    if (gtips.length) list.appendChild(globalSection());
  }
  const shownAny = rows.length || gtips.length;
  if (!shownAny) {
    const e = el("div", "empty", all.length || tips.length ? "Nothing matches the search." : "No handoffs yet. Save one with /handoff.");
    if (q) {
      const clear = el("button", "", "Clear search");
      clear.addEventListener("click", clearSearch);
      e.appendChild(el("br")); e.appendChild(clear);
    }
    list.appendChild(e);
  }
  markOpen();
}

async function load() {
  try {
    const r = await fetch("api/tasks", { cache: "no-store" });
    signedOut(r);
    if (!r.ok) throw new Error("HTTP " + r.status);
    const next = await r.json();
    $("#error").hidden = true;
    $("#logout").hidden = !next.auth;
    const same = data && JSON.stringify(next) === JSON.stringify(data);
    data = next;
    if (!same) render();
  } catch (e) {
    $("#error").textContent = "Cannot reach the handoffs server (" + e.message + "). Is it still running?";
    $("#error").hidden = false;
  }
}

$("#reload").appendChild(icon("reload"));
$("#logout").appendChild(icon("logout"));
$("#logout").addEventListener("click", async () => {
  try { await post("logout", {}); } catch (e) { /* signed out already */ }
  location.href = "login";
});
// Theme button: auto (system) -> light -> dark -> auto; kept in localStorage.
const THEMES = { auto: "light", light: "dark", dark: "auto" };
function setTheme(t) {
  const b = $("#theme");
  if (t === "auto") delete document.documentElement.dataset.theme; else document.documentElement.dataset.theme = t;
  try { if (t === "auto") localStorage.removeItem("handoffs.theme"); else localStorage.setItem("handoffs.theme", t); } catch (e) { /* private mode */ }
  b.textContent = "";
  b.appendChild(icon(t === "light" ? "sun" : t === "dark" ? "moon" : "auto"));
  b.title = "Theme: " + t + " (click: " + THEMES[t] + ")";
  b.setAttribute("aria-label", b.title);
}
setTheme(document.documentElement.dataset.theme || "auto");
$("#theme").addEventListener("click", () => setTheme(THEMES[document.documentElement.dataset.theme || "auto"]));
$("#pclose").appendChild(icon("close"));
$("#pclose").addEventListener("click", closePanel);
$("#scrim").addEventListener("click", closePanel);
$("#reload").addEventListener("click", load);
$("#navsel").addEventListener("change", (e) => pick(e.target.value));
window.addEventListener("popstate", () => { state.proj = fromHash(); render(); });
state.proj = fromHash();
let searchTimer = 0;
$("#q").addEventListener("input", (e) => {
  state.q = e.target.value;
  clearTimeout(searchTimer);
  if (state.q.trim().length < 2) { hits = new Map(); render(); return; }
  render();
  searchTimer = setTimeout(async () => {
    const q = state.q;
    try {
      const res = await api("search", { q });
      if (q !== state.q) return;
      hits = new Map(res.map((h) => [keyOf(h), h.snippet]));
      render();
    } catch (err) { /* keep the local filter */ }
  }, 300);
});
function clearSearch() {
  $("#q").value = "";
  $("#q").dispatchEvent(new Event("input"));
}
// "/" focuses the search, Esc in it clears and leaves it.
document.addEventListener("keydown", (e) => {
  const t = e.target;
  if (e.key === "Escape" && !$("#panel").hidden) { e.preventDefault(); closePanel(); return; }
  if (t === $("#q")) {
    if (e.key === "Escape") { e.preventDefault(); clearSearch(); t.blur(); }
    return;
  }
  if (e.key !== "/" || e.ctrlKey || e.metaKey || e.altKey || t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
  e.preventDefault();
  $("#q").focus();
});
document.addEventListener("visibilitychange", () => { if (!document.hidden) load(); });
setInterval(() => { if (!document.hidden) load(); }, 30000);
load();
</script>
</body>
</html>
"""

if __name__ == "__main__":
    sys.exit(main())
