<script>
"use strict";
const $ = (s) => document.querySelector(s);
const state = { q: "", archOpen: [], tab: {}, open: null, globalOpen: false, proj: "all" };  // open: key of the item in the panel
// Global tips start collapsed on every load; drop the state 1.4.0 and older kept.
try { localStorage.removeItem("handoffs.globalOpen"); } catch (e) { /* private mode */ }
let data = null;
let hits = new Map();  // full-text search: task key -> snippet
const LABEL = "Copy";
const IDLE_DAYS = 14;
const TOKEN = "__TOKEN__";

function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}

// Appends text with the search query wrapped in <mark>.
function hl(parent, text) {
  const q = state.q.trim().toLowerCase();
  const s = String(text);
  if (q.length < 2) { parent.appendChild(document.createTextNode(s)); return parent; }
  const low = s.toLowerCase();
  let at = 0, i;
  while ((i = low.indexOf(q, at)) >= 0) {
    if (i > at) parent.appendChild(document.createTextNode(s.slice(at, i)));
    parent.appendChild(el("mark", "", s.slice(i, i + q.length)));
    at = i + q.length;
  }
  if (at < s.length) parent.appendChild(document.createTextNode(s.slice(at)));
  return parent;
}

// Text with `inline code` spans and search highlights; never parsed as HTML.
function rich(tag, cls, text) {
  const e = el(tag, cls);
  String(text).split(/`([^`]+)`/).forEach((part, i) => {
    if (part) i % 2 ? e.appendChild(hl(el("code"), part)) : hl(e, part);
  });
  return e;
}

function age(iso) {
  const t = Date.parse(iso);
  if (isNaN(t)) return "";
  const s = Math.max(0, (Date.now() - t) / 1000);
  if (s < 60) return "just now";
  if (s < 3600) return Math.floor(s / 60) + "m ago";
  if (s < 86400) return Math.floor(s / 3600) + "h ago";
  if (s < 86400 * 14) return Math.floor(s / 86400) + "d ago";
  if (s < 86400 * 60) return Math.floor(s / 86400 / 7) + "w ago";
  return new Date(t).toLocaleDateString();
}

const sq = (s) => "'" + s.replace(/'/g, "'\\''") + "'";
function underHome(p) {
  const h = data && data.home;
  if (!h || h === "/") return null;
  if (p === h) return "";
  return p.startsWith(h + "/") ? p.slice(h.length + 1) : null;
}
function tilde(p) {
  const r = underHome(p);
  return r === null ? p : r ? "~/" + r : "~";
}
function command(t) {
  const run = 'claude "/pickup @' + t.task + '"';
  if (!t.project_exists) return run;
  const r = underHome(t.project);
  const dir = r === null ? sq(t.project) : r ? "~/" + sq(r) : "~";
  return "cd " + dir + " && " + run;
}

async function copy(text, btn, codeEl, label) {
  const lbl = btn.querySelector(".lbl") || btn;
  const done = (msg) => {
    lbl.textContent = msg;
    btn.classList.add("ok");
    btn.replaceChild(icon("check"), btn.querySelector("svg"));
    setTimeout(() => {
      lbl.textContent = label;
      btn.classList.remove("ok");
      btn.replaceChild(icon("copy"), btn.querySelector("svg"));
    }, 1500);
  };
  try {
    await navigator.clipboard.writeText(text);
    return done("Copied");
  } catch (e) { /* fall through */ }
  try {
    const a = document.createElement("textarea");
    a.value = text; a.setAttribute("readonly", ""); a.style.position = "fixed"; a.style.opacity = "0";
    document.body.appendChild(a); a.select();
    const ok = document.execCommand("copy");
    a.remove();
    if (ok) return done("Copied");
  } catch (e) { /* fall through */ }
  codeEl.hidden = false;
  const r = document.createRange(); r.selectNodeContents(codeEl);
  const sel = getSelection(); sel.removeAllRanges(); sel.addRange(r);
  done("Selected");
}

// --- markdown (DOM-built, never innerHTML) ---
function link(href, text) {
  const a = el("a", "", text);
  a.href = href; a.target = "_blank"; a.rel = "noopener noreferrer";
  return a;
}

function inline(parent, text) {
  const re = /(`[^`]+`)|\*\*([^*]+)\*\*|\[([^\]]+)\]\((https?:\/\/[^\s)]+)\)|(https?:\/\/[^\s<>()]*[^\s<>().,;:!?'"])/g;
  let last = 0, m;
  while ((m = re.exec(text))) {
    if (m.index > last) parent.appendChild(document.createTextNode(text.slice(last, m.index)));
    if (m[1]) parent.appendChild(el("code", "", m[1].slice(1, -1)));
    else if (m[2]) { const b = el("strong"); inline(b, m[2]); parent.appendChild(b); }
    else if (m[3]) parent.appendChild(link(m[4], m[3]));
    else parent.appendChild(link(m[5], m[5]));
    last = re.lastIndex;
  }
  if (last < text.length) parent.appendChild(document.createTextNode(text.slice(last)));
  return parent;
}

const ITEM = /^\s*([-*+]|\d+[.)])\s+(.*)$/;
const BLOCK = /^(#{1,6}\s|```|~~~|\|)/;
const indentOf = (l) => l.match(/^\s*/)[0].replace(/\t/g, "    ").length;

function mdList(lines, i, parent) {
  const base = indentOf(lines[i]);
  const list = el(/^\s*\d/.test(lines[i]) ? "ol" : "ul");
  let li = null;
  while (i < lines.length) {
    const l = lines[i];
    if (!l.trim()) {
      const n = lines[i + 1];
      if (n !== undefined && n.trim() && indentOf(n) >= base && (ITEM.test(n) || indentOf(n) > base)) { i++; continue; }
      break;
    }
    const ind = indentOf(l), m = l.match(ITEM);
    if (m && ind <= base + 1 && ind >= base) { li = inline(el("li"), m[2]); list.appendChild(li); i++; }
    else if (m && ind > base && li) i = mdList(lines, i, li);
    else if (!m && ind > base && li) { li.appendChild(document.createTextNode(" ")); inline(li, l.trim()); i++; }
    else break;
  }
  parent.appendChild(list);
  return i;
}

function cells(l) {
  return l.trim().replace(/^\|/, "").replace(/\|$/, "").split("|").map((c) => c.trim());
}

function markdown(src, title) {
  const root = el("div", "md");
  const lines = src.replace(/\r/g, "").split("\n");
  let i = 0, m;
  while (i < lines.length) {
    const line = lines[i];
    if (!line.trim()) { i++; continue; }
    if ((m = line.match(/^(```|~~~)/))) {
      const buf = [];
      for (i++; i < lines.length && !lines[i].startsWith(m[1]); i++) buf.push(lines[i]);
      i++;
      const pre = el("pre"); pre.appendChild(el("code", "", buf.join("\n"))); root.appendChild(pre);
    } else if ((m = line.match(/^(#{1,6})\s+(.*)$/))) {
      i++;
      if (m[1].length === 1 && m[2].trim() === title) continue;  // the card already shows the title
      root.appendChild(inline(el("h" + Math.min(6, m[1].length + 2)), m[2]));
    } else if (ITEM.test(line)) {
      i = mdList(lines, i, root);
    } else if (line.trim().startsWith("|")) {
      const table = el("table");
      let head = true;
      for (; i < lines.length && lines[i].trim().startsWith("|"); i++) {
        if (/^\s*\|?[\s:|-]+\|?\s*$/.test(lines[i]) && lines[i].includes("-")) { head = false; continue; }
        const tr = el("tr");
        cells(lines[i]).forEach((c) => tr.appendChild(inline(el(head ? "th" : "td"), c)));
        table.appendChild(tr);
      }
      root.appendChild(table);
    } else {
      const buf = [];
      while (i < lines.length && lines[i].trim() && !BLOCK.test(lines[i]) && !ITEM.test(lines[i])) buf.push(lines[i++].trim());
      root.appendChild(inline(el("p"), buf.join(" ")));
    }
  }
  return root;
}

const ICONS = {
  // Lucide icons (ISC license, lucide.dev); circles, lines and rects written as paths.
  copy: ["M10 8h10a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2z", "M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"],
  check: ["M20 6 9 17l-5-5"],
  undo: ["M9 14 4 9l5-5", "M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11"],
  down: ["m6 9 6 6 6-6"],
  right: ["m9 18 6-6-6-6"],
